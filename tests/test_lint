#!/usr/bin/env bash
# Commit gate for the MASKED RETURN VALUE defect class.
#
# The family: a check whose failure is indistinguishable from its success.
# In MFIC terms it is the ¬F axis — the control cannot produce a biting
# refutation, so it reports green regardless of the truth. Observed instances
# across this fleet in a single week:
#
#   ./test:46            `build | tail -3 || fatal`  — `||` reads tail's status
#   dotfiles pre-push    `--check-only` documented, never parsed
#   dotfiles session_test asserted `-Ad`, pinning the bug it should have caught
#   test_cli:307         two failing commands both emit "", compare equal, pass
#   test_no_signing_syms `nm` denylist: green while a working signer shipped
#
# Zig makes the core of this class a COMPILE ERROR (unused return values and
# unhandled errors are rejected outright), which is why five review agents found
# zero instances in the Zig core and all of them in C and Bash. C and Bash make
# the same checks opt-in — so this file is that opt-in, enforced.
#
# ShellCheck ships SC2312 DISABLED by default under
# `-o check-extra-masked-returns`. It was findable all along.
#
# Per Mecha conventions: `set -u` only. `set -e` would abort on the non-zero
# exits this file exists to assert on.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
PASS=0
FAIL=0

pass() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
fail() {
	FAIL=$((FAIL + 1))
	printf '  FAIL %s\n' "$1" >&2
	[[ $# -gt 1 ]] && printf '%s\n' "$2" >&2
	return 0
}

# A missing linter must FAIL, never skip. A gate that silently disappears when
# its tool is absent is the very defect this file polices — see the `nm`
# lesson, where a dead binary would have made every negative assertion
# vacuously true.
require_tool() {
	if command -v "$1" >/dev/null 2>&1; then
		return 0
	fi
	fail "$1 is available" "  the gate cannot run without it; add it to flake.nix rather than skipping"
	return 1
}

# parse_aborted FINDINGS: shellcheck stopped parsing, so it inspected only the
# text before the error. SC1072 and SC1073 are its "fix this and try again"
# markers; the run still exits 1, exactly like a file with ordinary findings.
parse_aborted() { grep -qE '\[SC107[23]\]' <<<"$1"; }

# ── Bash: SC2312 masked return values ───────────────────────────────────────
# discover_shell_scripts ROOT: every shell script under ROOT, one path per
# line, found rather than listed, so a new or renamed script cannot slip out
# of the gate. A script has a bash or sh shebang or a .sh name. The pruned
# directories are the ignored build, cache and mail trees (.gitignore).
discover_shell_scripts() {
	find "$1" \( -name .git -o -name .zig-cache -o -name zig-cache -o -name zig-out \
		-o -name zig-pkg -o -name .nix-out -o -name .direnv -o -name inbox \
		-o -name .codescan -o -name .serena -o -name .mutate.lock -o -name target \) -prune \
		-o -type f -exec awk 'FNR == 1 {
			if ($0 ~ /^#!.*(bash|\/sh)([ \t]|$)/ || FILENAME ~ /\.sh$/) print FILENAME
			nextfile
		}' {} +
}

if require_tool shellcheck; then
	# Scripts that still mask return values, each with its exact count of
	# findings. They predate discovery (the hand list it replaced left them
	# out). A count that moves, an entry naming no discovered script, or a
	# listed script that is clean fails the gate, so this list only shrinks.
	declare -A pending=(
		[examples/hint_vectors/generate]=23
		[examples/license_vectors/generate]=2
		[examples/license_vectors_v2/generate]=77
		[examples/renewal_vectors/generate]=12
		[mutate]=1
		[tests/integration/hint_vectors.sh]=2
		[tests/integration/install_cert_vectors.sh]=20
		[tests/integration/license_vectors.sh]=9
		[tests/integration/license_vectors_v2.sh]=14
		[tests/integration/macos_archive.sh]=2
		[tests/integration/renewal_vectors.sh]=30
		[tests/integration/restore_check_payload.sh]=3
		[tests/integration/update_vectors.sh]=2
		[tests/integration/zig_consumer.sh]=14
		[tests/test_c_conformance]=3
	)
	declare -A seen=()

	found="$(mktemp "${TMPDIR:-/tmp}/sigil-lint-scripts-XXXXXX")"
	if ! discover_shell_scripts "$REPO_ROOT" >"$found"; then
		fail "the shell scripts are discovered" "       find or awk failed under $REPO_ROOT"
	fi
	sort -o "$found" "$found"
	mapfile -t shell_scripts <"$found"
	rm -f "$found"
	if [[ ${#shell_scripts[@]} -lt 20 ]]; then
		fail "the shell scripts are discovered" "       only ${#shell_scripts[@]} found under $REPO_ROOT"
	fi

	# ShellCheck runs on up to 8 scripts at once (each peaks near 90 MB),
	# because ./test waits for this suite before its other suites start.
	# Each run records its output and exit status; the verdicts below are
	# judged in path order.
	scdir="$(mktemp -d "${TMPDIR:-/tmp}/sigil-lint-sc-XXXXXX")"
	running=0
	for i in "${!shell_scripts[@]}"; do
		if (( running >= 8 )); then
			wait -n
			running=$((running - 1))
		fi
		{
			shellcheck -o check-extra-masked-returns -f gcc "${shell_scripts[i]}" >"$scdir/$i.out" 2>/dev/null
			echo "$?" >"$scdir/$i.rc"
		} &
		running=$((running + 1))
	done
	wait

	for i in "${!shell_scripts[@]}"; do
		script=${shell_scripts[i]}
		rel="${script#"$REPO_ROOT"/}"
		findings=$(<"$scdir/$i.out")
		sc_rc=$(<"$scdir/$i.rc")
		# ShellCheck itself failing to run is distinct from finding nothing.
		if [[ $sc_rc -gt 1 ]]; then
			fail "shellcheck runs on $rel" "  shellcheck exited $sc_rc — the gate did not actually inspect this file"
			continue
		fi
		# So is a parse abort, which exits 1 like an ordinary finding.
		if parse_aborted "$findings"; then
			# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
			fail "shellcheck parses $rel" "$(sed 's/^/       /' <<<"$findings")"
			continue
		fi
		masked=$(grep -c 'SC2312' <<<"$findings")
		[[ -z "$findings" ]] && masked=0
		if [[ -v "pending[$rel]" ]]; then
			seen[$rel]=1
			if [[ "$masked" -eq "${pending[$rel]}" ]]; then
				pass "pending cleanup: $rel still has exactly its $masked known masked return values"
			elif [[ "$masked" -lt "${pending[$rel]}" ]]; then
				fail "pending cleanup: $rel is down to $masked masked return values; set its pending count to $masked, or remove it at 0"
			else
				# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
				fail "no new masked return values in $rel (pending ${pending[$rel]}, now $masked)" \
					"$(grep 'SC2312' <<<"$findings" | sed 's/^/       /')"
			fi
		elif [[ "$masked" -eq 0 ]]; then
			pass "no masked return values in $rel"
		else
			# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
			fail "no masked return values in $rel" \
				"$(grep 'SC2312' <<<"$findings" | sed 's/^/       /')"
		fi
	done
	for rel in "${!pending[@]}"; do
		[[ -v "seen[$rel]" ]] || fail "pending cleanup entry $rel names a discovered shell script"
	done

	# Meta-control for discovery: a scratch tree with a shebang script, a .sh
	# file, a non-script, and a script inside a pruned build directory must
	# yield exactly the first two.
	dtree="$(mktemp -d "${TMPDIR:-/tmp}/sigil-lint-discover-XXXXXX")"
	mkdir -p "$dtree/bin" "$dtree/zig-out"
	printf '#!/usr/bin/env bash\ntrue\n' >"$dtree/bin/tool"
	printf 'true\n' >"$dtree/bin/lib.sh"
	printf 'not a script\n' >"$dtree/notes"
	printf '#!/bin/sh\ntrue\n' >"$dtree/zig-out/built"
	if dfound=$(discover_shell_scripts "$dtree"); then
		dfound=$(sort <<<"$dfound")
	else
		dfound="(discovery failed)"
	fi
	if [[ "$dfound" == "$dtree/bin/lib.sh"$'\n'"$dtree/bin/tool" ]]; then
		pass "discovery finds shebang and .sh scripts, skipping pruned build trees (specificity corpus)"
	else
		fail "discovery finds shebang and .sh scripts, skipping pruned build trees (specificity corpus)" "$dfound"
	fi
	rm -rf -- "$dtree" "$scdir"

	# Meta-control: prove the gate can still fire. A lint gate that has been
	# quietly defanged (wrong flag, wrong file list, tool stubbed) looks
	# identical to a clean repo. Feed it a known violation and require a catch.
	probe="$(mktemp "${TMPDIR:-/tmp}/sigil-lint-probe-XXXXXX.sh")"
	cat > "$probe" <<'PROBE'
#!/usr/bin/env bash
set -u
./build 2>&1 | tail -3 || { echo "FATAL"; exit 1; }
PROBE
	probe_findings=$(shellcheck -o check-extra-masked-returns -f gcc "$probe" 2>/dev/null)
	if grep -q 'SC2312' <<<"$probe_findings"; then
		pass "the gate still fires on a known violation (specificity corpus)"
	else
		fail "the gate still fires on a known violation (specificity corpus)" \
			"       SC2312 did not trigger on a deliberately masked pipeline — the gate is defanged"
	fi
	# A file that stops the parser must not pass as clean. A comment that
	# opens with the tool's lowercase name reads as a malformed directive.
	cat > "$probe" <<'PROBE'
#!/usr/bin/env bash
set -u
# shellcheck finds masked returns
./build 2>&1 | tail -3 || { echo "FATAL"; exit 1; }
PROBE
	probe_findings=$(shellcheck -o check-extra-masked-returns -f gcc "$probe" 2>/dev/null)
	if parse_aborted "$probe_findings"; then
		pass "the gate detects a parse abort (specificity corpus)"
	else
		fail "the gate detects a parse abort (specificity corpus)" "$probe_findings"
	fi
	rm -f "$probe"
fi

# ── C: unchecked return values (the same class, different language) ─────────
# `-Wunused-result` only fires on functions annotated warn_unused_result, so it
# is necessary but nowhere near sufficient. cert-err33-c is the real check: it
# flags ignored returns from standard library calls that can fail.
if require_tool clang-tidy; then
	c_sources=()
	for candidate in "$REPO_ROOT/cli/main.c"; do
		[[ -f "$candidate" ]] && c_sources+=("$candidate")
	done

	for src in "${c_sources[@]}"; do
		rel="${src#"$REPO_ROOT"/}"
		# Check set chosen for SILENCE ON CORRECT CODE. Two checks were tried
		# and rejected because a gate that fires on correct code is a gate
		# everyone learns to scroll past — the same "trains you to ignore red"
		# failure this file exists to prevent:
		#   cert-err33-c   — 39 hits, every one an `fprintf(stderr, …)`.
		#                    An unwritable stderr cannot be reported anyway.
		#   security.insecureAPI.DeprecatedOrUnsafeBufferHandling — demands
		#                    C11 Annex K (`fprintf_s`), which glibc does not
		#                    implement and which is broadly considered a failed
		#                    standard.
		# Verified: 0 warnings on cli/main.c as it stands, and it does catch a
		# planted double-free and strcpy overflow. Coverage is partial (it
		# missed a planted leak and an uninitialized read) — treat it as a
		# floor, not a proof.
		out=$(clang-tidy \
			--quiet \
			--checks='-*,bugprone-unused-return-value,bugprone-suspicious-memory-comparison,clang-analyzer-unix.Malloc,clang-analyzer-core.NullDereference,clang-analyzer-core.uninitialized.*,clang-analyzer-deadcode.DeadStores,clang-analyzer-security.insecureAPI.UncheckedReturn,clang-analyzer-security.insecureAPI.strcpy' \
			"$src" -- -std=c11 -I "$REPO_ROOT/include" 2>/dev/null)
		tidy_rc=$?
		if [[ $tidy_rc -gt 1 ]]; then
			fail "clang-tidy runs on $rel" "  exited $tidy_rc — the gate did not actually inspect this file"
			continue
		fi
		warnings=$(grep -c 'warning:' <<<"$out")
		[[ -z "$out" ]] && warnings=0
		if [[ "$warnings" -eq 0 ]]; then
			pass "no ignored return values in $rel"
		else
			# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
			fail "no ignored return values in $rel" \
				"$(grep 'warning:' <<<"$out" | sed 's/^/       /' | head -20)"
		fi
	done

	# Meta-control, same as the shell side: a check set this narrow could be
	# silent because the code is clean, or silent because it was defanged.
	# Those look identical from the outside, so prove it still bites.
	cprobe="$(mktemp "${TMPDIR:-/tmp}/sigil-tidy-probe-XXXXXX.c")"
	cat > "$cprobe" <<'CPROBE'
#include <stdlib.h>
int main(void) {
	char *q = malloc(8);
	free(q);
	free(q);
	return 0;
}
CPROBE
	cprobe_out=$(clang-tidy --quiet \
		--checks='-*,clang-analyzer-unix.Malloc' \
		"$cprobe" -- -std=c11 2>/dev/null)
	if grep -q 'warning:' <<<"$cprobe_out"; then
		pass "the C gate still fires on a known violation (specificity corpus)"
	else
		fail "the C gate still fires on a known violation (specificity corpus)" \
			"       a planted double-free went unreported — clang-tidy is not actually analyzing"
	fi
	rm -f "$cprobe"
fi

printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"
exit "$FAIL"
