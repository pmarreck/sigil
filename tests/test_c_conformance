#!/usr/bin/env bash
# Build and run the C conformance consumer with a STOCK C compiler.
#
# This is the customer's link path, and until 2026-07-28 nothing exercised it.
# `zig build` supplies compiler-rt and links the Zig way, so libsigil.a was
# unlinkable by plain `cc` for two independent reasons — a non-PIC archive
# against a default-PIE toolchain, and unresolved 128-bit soft-float symbols
# pulled in by std.json's number parser — while every test reported green.
#
# Deliberately does NOT use `zig cc`. Using it would restore exactly the blind
# spot this file exists to remove.
#
# Per Mecha conventions: `set -u` only.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
LIB="$REPO_ROOT/zig-out/lib/libsigil.a"
SRC="$SCRIPT_DIR/conformance/verify_conformance.c"

if [[ ! -f "$LIB" ]]; then
	echo "FATAL: $LIB not found — run ./build first" >&2
	exit 1
fi

# Pick a compiler that is NOT zig. `cc` is the customer's default.
CC="${CC:-cc}"
if ! command -v "$CC" >/dev/null 2>&1; then
	echo "FATAL: no stock C compiler ($CC) — the customer link path cannot be tested" >&2
	exit 1
fi
case "$("$CC" --version 2>&1 | head -1)" in
	*zig*)
		echo "FATAL: \$CC resolves to zig cc, which hides the very failure this test exists to catch." >&2
		echo "       Set CC to gcc or clang." >&2
		exit 1
		;;
esac

bin="$(mktemp "${TMPDIR:-/tmp}/sigil-conformance-XXXXXX")"
trap 'rm -f "$bin"' EXIT

build_log=$("$CC" -std=c11 -Wall -Wextra -I "$REPO_ROOT/include" "$SRC" "$LIB" -o "$bin" 2>&1)
build_rc=$?
if [[ $build_rc -ne 0 ]]; then
	echo "FAIL libsigil.a cannot be linked by a stock C compiler ($CC)" >&2
	echo "$build_log" | sed 's/^/     /' >&2
	echo ""
	echo "0 passed, 1 failed"
	exit 1
fi
echo "  ok   libsigil.a links with a stock C compiler ($("$CC" --version 2>&1 | head -1))"

# The fixture triple is sigil's own signed output, committed under
# examples/demo/. It restores the sensitivity the RFC raw vector provided
# before the transcript change (that vector is now the domain-separation
# rejection case instead).
run_out=$("$bin" "$REPO_ROOT/examples/demo/payload.bin" \
                 "$REPO_ROOT/examples/demo/sig.bin" \
                 "$REPO_ROOT/examples/demo/pubkey.bin")
run_rc=$?
echo "$run_out" | grep -E '^  (ok|FAIL)' || true

passed=$(grep -c '^  ok' <<<"$run_out")
# +1 for the link check emitted above.
passed=$((passed + 1))
total_rc=$run_rc

# Header-only, pure helpers, tested directly: the exit-code classifier (you
# cannot induce a real allocation failure from a shell) and the JSON escaper.
je_bin="$(mktemp "${TMPDIR:-/tmp}/sigil-jsonesc-XXXXXX")"
ec_bin="$(mktemp "${TMPDIR:-/tmp}/sigil-exitcodes-XXXXXX")"
trap 'rm -f "$bin" "$ec_bin" "$je_bin"' EXIT

ec_build=$("$CC" -std=c11 -Wall -Wextra \
	-I "$REPO_ROOT/include" -I "$REPO_ROOT/cli" \
	"$SCRIPT_DIR/conformance/exit_codes_test.c" -o "$ec_bin" 2>&1)
if [[ $? -ne 0 ]]; then
	echo "  FAIL exit-code classifier does not compile" >&2
	echo "$ec_build" | sed 's/^/     /' >&2
	total_rc=1
else
	ec_out=$("$ec_bin")
	ec_rc=$?
	grep -E '^  (ok|FAIL)' <<<"$ec_out" || true
	ec_passed=$(grep -c '^  ok' <<<"$ec_out")
	passed=$((passed + ec_passed))
	[[ $ec_rc -ne 0 ]] && total_rc=1
fi

je_build=$("$CC" -std=c11 -Wall -Wextra \
	-I "$REPO_ROOT/include" -I "$REPO_ROOT/cli" \
	"$SCRIPT_DIR/conformance/json_escape_test.c" "$LIB" -o "$je_bin" 2>&1)
if [[ $? -ne 0 ]]; then
	echo "  FAIL JSON escaper does not compile" >&2
	echo "$je_build" | sed 's/^/     /' >&2
	total_rc=1
else
	je_out=$("$je_bin")
	je_rc=$?
	grep -E '^  (ok|FAIL)' <<<"$je_out" || true
	je_passed=$(grep -c '^  ok' <<<"$je_out")
	passed=$((passed + je_passed))
	[[ $je_rc -ne 0 ]] && total_rc=1
fi

# The shipped example must keep compiling and keep being RIGHT. Documentation
# already rotted once in this repo (ten stale invariant statements survived a
# format change); an example that is also a test cannot. This is the exact
# call sequence the integration note hands to Validate/RotShield, run against
# the committed demo fixtures, with a tamper control so "verifies" is a
# statement about the crypto and not about a happy accident.
ex_bin="$(mktemp "${TMPDIR:-/tmp}/sigil-embed-example-XXXXXX")"
trap 'rm -f "$bin" "$ec_bin" "$je_bin" "$ex_bin"' EXIT

ex_build=$("$CC" -std=c11 -Wall -Wextra \
	-I "$REPO_ROOT/include" \
	"$REPO_ROOT/examples/embed_minimal.c" "$LIB" -o "$ex_bin" 2>&1)
if [[ $? -ne 0 ]]; then
	echo "  FAIL examples/embed_minimal.c does not compile with a stock cc" >&2
	echo "$ex_build" | sed 's/^/     /' >&2
	total_rc=1
else
	ex_out=$("$ex_bin" "$REPO_ROOT/examples/demo/license.sigil" \
	                   "$REPO_ROOT/examples/demo/demo.key.pub" 2>/dev/null)
	if [[ $? -eq 0 && "$ex_out" == *'"product":"mecha-validate"'* ]]; then
		echo "  ok   embed_minimal verifies the demo license and emits its payload"
		passed=$((passed + 1))
	else
		echo "  FAIL embed_minimal did not verify the demo license" >&2
		total_rc=1
	fi

	# Control: one corrupted byte must flip the verdict to exit 1, or the
	# check above proves nothing.
	tampered="$(mktemp "${TMPDIR:-/tmp}/sigil-embed-tampered-XXXXXX")"
	sed 's/peter@example/hacker@example/' \
		"$REPO_ROOT/examples/demo/license.sigil" > "$tampered"
	if cmp -s "$tampered" "$REPO_ROOT/examples/demo/license.sigil"; then
		echo "  FAIL tamper control is vacuous (sed matched nothing)" >&2
		total_rc=1
	else
		"$ex_bin" "$tampered" "$REPO_ROOT/examples/demo/demo.key.pub" >/dev/null 2>&1
		if [[ $? -eq 1 ]]; then
			echo "  ok   embed_minimal rejects a tampered license (exit 1)"
			passed=$((passed + 1))
		else
			echo "  FAIL embed_minimal accepted a tampered license" >&2
			total_rc=1
		fi
	fi
	rm -f "$tampered"
fi

printf '\n%d passed, %d failed\n' "$passed" "$total_rc"
exit "$total_rc"
