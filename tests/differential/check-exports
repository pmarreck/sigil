#!/usr/bin/env bash
# check-exports ARCHIVE HEADER: the archive's strong global definitions are
# exactly the functions HEADER declares. Prints the difference and exits 1
# otherwise, so an implementation can neither miss a declared function nor
# leak an extra global that would collide with another archive in the same
# binary.
#
# Excluded: weak definitions, which yield to any strong one at link time, and
# names in the reserved "__" namespace, where compiler runtimes live. The
# declared list comes from scripts/c-header-functions, the same parser the
# Rust packaging uses.
#
# Per Mecha conventions: `set -u` only.
set -u

if [[ $# -ne 2 || ! -f "$1" || ! -f "$2" ]]; then
	echo "usage: check-exports ARCHIVE HEADER" >&2
	exit 64
fi
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
work="$(mktemp -d "${TMPDIR:-/tmp}/check-exports-XXXXXX")" || exit 1
trap 'rm -rf -- "$work"' EXIT

bash "$REPO_ROOT/scripts/c-header-functions" "$2" >"$work/declared" || exit 1
nm -g --defined-only "$1" >"$work/nm" 2>"$work/nm-err" || { cat "$work/nm-err" >&2; exit 1; }
awk 'NF == 3 && $2 ~ /^[TDBR]$/ && $3 !~ /^__/ { print $3 }' "$work/nm" >"$work/exported"
sort -u -o "$work/exported" "$work/exported"
if ! diff "$work/declared" "$work/exported" >"$work/diff"; then
	echo "< declared only, > exported only:"
	grep '^[<>]' "$work/diff"
	exit 1
fi
wc -l <"$work/declared"
