#!/usr/bin/env bash
# Architecture invariant for the Rust implementation, checked mechanically.
#
# CLAIM: a product that links the Rust libsigil.a cannot mint a license,
# because the code to sign is not in the archive. The Zig counterpart is
# tests/test_no_signing_symbols; this one reads the Rust package's archives.
#
#   A. The archive's strong globals are exactly the functions include/sigil.h
#      declares (tests/differential/check-exports), so nothing is smuggled
#      out under another name.
#   B. A cryptographic oracle: primitives only signing reaches (fixed-base
#      multiplication by a secret scalar, its precomputed table, secret-key
#      expansion) and the key-custody ciphers. Each must be present in
#      libsigil_sign.a, so the patterns demonstrably match something, and
#      absent from libsigil.a.
#   C. Verification code is present and its symbols readable, so the absence
#      checks cannot pass on a stripped or empty archive.
#
# The prelinked archives keep these symbols local but named; nm -C reads them
# demangled, with the trailing hash removed.
#
# Per Mecha conventions: `set -u` only.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIBDIR="${SIGIL_RUST_OUT:-$ROOT/.nix-out/rust-release}/lib"
NM="${NM:-nm}"
PASS=0
FAIL=0
pass() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
fail() {
	FAIL=$((FAIL + 1))
	printf '  FAIL %s\n' "$1" >&2
	# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
	if [[ $# -gt 1 ]]; then head -20 <<<"$2" | sed 's/^/       /' >&2; fi
}
finish() { printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"; exit "$FAIL"; }

work="$(mktemp -d "${TMPDIR:-/tmp}/sigil-rust-symbols-XXXXXX")" || exit 1
trap 'rm -rf -- "$work"' EXIT
verifier="$LIBDIR/libsigil.a"
signer="$LIBDIR/libsigil_sign.a"
echo "custody control (Rust) — libdir: $LIBDIR"
for f in "$verifier" "$signer"; do
	if [[ ! -f "$f" ]]; then
		fail "the Rust package provides ${f##*/}" "missing: $f"
		finish
	fi
done

# symbols ARCHIVE OUT: every defined symbol, demangled, hash suffix removed.
# nm's status is checked on its own: piped, a dead nm would yield an empty
# list and every absence check below would pass vacuously.
symbols() {
	if ! "$NM" -C --defined-only "$1" >"$work/raw" 2>"$work/err"; then
		echo "nm failed on $1: $(<"$work/err")"
		return 1
	fi
	awk 'NF >= 3 { $1 = ""; $2 = ""; print substr($0, 3) }' "$work/raw" >"$work/names"
	sed -E 's/::h[0-9a-f]{16}$//' "$work/names" >"$2"
	sort -u -o "$2" "$2"
}
for which in verifier signer; do
	if ! why=$(symbols "${!which}" "$work/$which"); then
		fail "read the symbols of ${!which}" "$why"
		finish
	fi
	count=$(wc -l <"$work/$which")
	if [[ $count -ge 200 ]]; then
		pass "read $count symbols from ${!which##*/}"
	else
		fail "read enough symbols from ${!which##*/} to judge it" "only $count"
		finish
	fi
done

# ── A. Exports are exactly the header ───────────────────────────────────────
if why=$(bash "$ROOT/tests/differential/check-exports" "$verifier" "$ROOT/include/sigil.h"); then
	pass "libsigil.a exports exactly the $why functions include/sigil.h declares"
else
	fail "libsigil.a exports exactly the functions include/sigil.h declares" "$why"
fi

# ── B. The cryptographic oracle ─────────────────────────────────────────────
# Exact names: signing multiplies the base point by a secret scalar through
# the constant-time table and expands the secret key; verification uses the
# variable-time double-base multiplication and neither of these.
SIGNING_ONLY=(
	'<curve25519_dalek::edwards::EdwardsPoint>::mul_base'
	'curve25519_dalek::backend::serial::u64::constants::ED25519_BASEPOINT_TABLE_INNER_DOC_HIDDEN'
	'<ed25519_dalek::hazmat::ExpandedSecretKey as core::convert::From<&[u8; 32]>>::from'
)
# Prefixes: the key-custody ciphers have no business in a verifier at all.
CUSTODY_ONLY=('argon2::' '<argon2::' 'chacha20poly1305::' '<chacha20poly1305::')

for sym in "${SIGNING_ONLY[@]}"; do
	if grep -qxF "$sym" "$work/signer"; then
		pass "the oracle sees '$sym' where signing happens"
	else
		fail "the oracle sees '$sym' where signing happens" "not in libsigil_sign.a: the name is stale, so its absence below means nothing"
	fi
	if grep -qxF "$sym" "$work/verifier"; then
		fail "libsigil.a contains no '$sym' (signing only)" "present: the shipping archive can compute a signature"
	else
		pass "libsigil.a contains no '$sym' (signing only)"
	fi
done
for prefix in "${CUSTODY_ONLY[@]}"; do
	if ! grep -qF "$prefix" "$work/signer"; then
		continue
	fi
	if grep -qF "$prefix" "$work/verifier"; then
		fail "libsigil.a contains nothing from '$prefix' (key custody only)" "present"
	else
		pass "libsigil.a contains nothing from '$prefix', which libsigil_sign.a does"
	fi
done

# ── C. The verification surface is present and readable ─────────────────────
for sym in 'sigil::verify::verify' 'sigil::verify::decode_point'; do
	if grep -qxF "$sym" "$work/verifier"; then
		pass "libsigil.a contains $sym (its symbols are readable, not stripped)"
	else
		fail "libsigil.a contains $sym" "absent: stripped or empty, so the absence checks above are vacuous"
	fi
done

finish
