#!/usr/bin/env bash
# Architecture invariant for the Rust implementation, checked mechanically.
#
# CLAIM: a product that links a Rust consumer archive cannot mint a license,
# because the code to sign is not in it. The consumer archives are
# libsigil.a (verify only) and libsigil_verify_policy.a (what a licensed
# application links); libsigil_verify_sign.a is the CLI's. The Zig
# counterpart is tests/test_no_signing_symbols.
#
#   A. Among sigil's and mecha_policy's names, each consumer archive's strong
#      globals are exactly its headers' functions
#      (tests/differential/check-exports --namespace), so nothing is smuggled
#      out under another sigil name.
#   B. A cryptographic oracle: primitives only signing reaches (fixed-base
#      multiplication by a secret scalar, its precomputed table, secret-key
#      expansion) and the key-custody ciphers. Each must be present in
#      libsigil_verify_sign.a, so the patterns demonstrably match something,
#      and absent from both consumer archives.
#   C. Verification code is present and its symbols readable in each consumer
#      archive, so the absence checks cannot pass on a stripped or empty one.
#
# nm -C reads the symbols demangled, with the trailing hash removed.
#
# Per Mecha conventions: `set -u` only.
set -u

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
LIBDIR="${SIGIL_RUST_OUT:-$ROOT/.nix-out/rust-release}/lib"
NM="${NM:-nm}"
PASS=0
FAIL=0
pass() { PASS=$((PASS + 1)); printf '  ok   %s\n' "$1"; }
fail() {
	FAIL=$((FAIL + 1))
	printf '  FAIL %s\n' "$1" >&2
	# shellcheck disable=SC2312  # diagnostic-only: the verdict is already recorded
	if [[ $# -gt 1 ]]; then head -20 <<<"$2" | sed 's/^/       /' >&2; fi
}
finish() { printf '\n%d passed, %d failed\n' "$PASS" "$FAIL"; exit "$FAIL"; }

work="$(mktemp -d "${TMPDIR:-/tmp}/sigil-rust-symbols-XXXXXX")" || exit 1
trap 'rm -rf -- "$work"' EXIT
verifier="$LIBDIR/libsigil.a"
app="$LIBDIR/libsigil_verify_policy.a"
signer="$LIBDIR/libsigil_verify_sign.a"
echo "custody control (Rust) — libdir: $LIBDIR"
for f in "$verifier" "$app" "$signer"; do
	if [[ ! -f "$f" ]]; then
		fail "the Rust package provides ${f##*/}" "missing: $f"
		finish
	fi
done

# symbols ARCHIVE OUT: every defined symbol, demangled, hash suffix removed.
# nm's status is checked on its own: piped, a dead nm would yield an empty
# list and every absence check below would pass vacuously.
symbols() {
	if ! "$NM" -C --defined-only "$1" >"$work/raw" 2>"$work/err"; then
		echo "nm failed on $1: $(<"$work/err")"
		return 1
	fi
	awk 'NF >= 3 { $1 = ""; $2 = ""; print substr($0, 3) }' "$work/raw" >"$work/names"
	sed -E 's/::h[0-9a-f]{16}$//' "$work/names" >"$2"
	sort -u -o "$2" "$2"
}
for which in verifier app signer; do
	if ! why=$(symbols "${!which}" "$work/$which"); then
		fail "read the symbols of ${!which}" "$why"
		finish
	fi
	count=$(wc -l <"$work/$which")
	if [[ $count -ge 200 ]]; then
		pass "read $count symbols from ${!which##*/}"
	else
		fail "read enough symbols from ${!which##*/} to judge it" "only $count"
		finish
	fi
done

# ── A. Exports are exactly the headers ──────────────────────────────────────
CHECK="$ROOT/tests/differential/check-exports"
POLICY_HEADER="$LIBDIR/../include/mecha_policy.h"
if why=$(bash "$CHECK" --namespace "$verifier" "$ROOT/include/sigil.h"); then
	pass "libsigil.a's sigil_ globals are exactly the $why functions include/sigil.h declares"
else
	fail "libsigil.a's sigil_ globals are exactly the functions include/sigil.h declares" "$why"
fi
if why=$(bash "$CHECK" --namespace "$app" "$ROOT/include/sigil.h" "$POLICY_HEADER"); then
	pass "libsigil_verify_policy.a's sigil_ and mecha_ globals are exactly the $why functions of sigil.h and mecha_policy.h"
else
	fail "libsigil_verify_policy.a's sigil_ and mecha_ globals are exactly the functions of sigil.h and mecha_policy.h" "$why"
fi

# ── B. The cryptographic oracle ─────────────────────────────────────────────
# Exact names: signing multiplies the base point by a secret scalar through
# the constant-time table and expands the secret key; verification uses the
# variable-time double-base multiplication and neither of these.
SIGNING_ONLY=(
	'<curve25519_dalek::edwards::EdwardsPoint>::mul_base'
	'curve25519_dalek::backend::serial::u64::constants::ED25519_BASEPOINT_TABLE_INNER_DOC_HIDDEN'
	'<ed25519_dalek::hazmat::ExpandedSecretKey as core::convert::From<&[u8; 32]>>::from'
)
# Prefixes: the key-custody ciphers have no business in a verifier at all.
CUSTODY_ONLY=('argon2::' '<argon2::' 'chacha20poly1305::' '<chacha20poly1305::')

CONSUMERS=(verifier app)
for sym in "${SIGNING_ONLY[@]}"; do
	if grep -qxF "$sym" "$work/signer"; then
		pass "the oracle sees '$sym' where signing happens"
	else
		fail "the oracle sees '$sym' where signing happens" "not in libsigil_verify_sign.a: the name is stale, so its absence below means nothing"
	fi
	for which in "${CONSUMERS[@]}"; do
		name=${!which##*/}
		if grep -qxF "$sym" "$work/$which"; then
			fail "$name contains no '$sym' (signing only)" "present: the shipping archive can compute a signature"
		else
			pass "$name contains no '$sym' (signing only)"
		fi
	done
done
for prefix in "${CUSTODY_ONLY[@]}"; do
	if ! grep -qF "$prefix" "$work/signer"; then
		continue
	fi
	for which in "${CONSUMERS[@]}"; do
		name=${!which##*/}
		if grep -qF "$prefix" "$work/$which"; then
			fail "$name contains nothing from '$prefix' (key custody only)" "present"
		else
			pass "$name contains nothing from '$prefix', which libsigil_verify_sign.a does"
		fi
	done
done

# ── C. The verification surface is present and readable ─────────────────────
for which in "${CONSUMERS[@]}"; do
	name=${!which##*/}
	for sym in 'sigil::verify::verify' 'sigil::verify::decode_point'; do
		if grep -qxF "$sym" "$work/$which"; then
			pass "$name contains $sym (its symbols are readable, not stripped)"
		else
			fail "$name contains $sym" "absent: stripped or empty, so the absence checks above are vacuous"
		fi
	done
done

finish
