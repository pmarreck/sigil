#!/usr/bin/env bash
# Build sigil.
# Defaults to ReleaseFast via `nix build` (sandboxed, deterministic).
# `./build --debug` for a debug build (uses bare zig build inside the dev shell).
set -uo pipefail

run() { "$@" || { echo "FAILED: $*" >&2; exit 1; }; }

optimize="ReleaseFast"
if [[ "${1:-}" == "--debug" ]]; then
	optimize="Debug"
	shift
elif [[ "${1:-}" == "--test" ]]; then
	optimize="ReleaseSafe"
	shift
fi

if [[ "$optimize" != "ReleaseFast" ]]; then
	# Non-release builds use zig directly (local dev only).
	run nix develop -c zig build "-Doptimize=$optimize" "$@"
elif command -v nix >/dev/null 2>&1; then
	run nix build "$@"
	mkdir -p zig-out/bin zig-out/lib
	run install -m755 result/bin/sigil zig-out/bin/sigil
	# Install EVERY archive the flake produces. tests/test_no_signing_symbols
	# inspects zig-out/lib, so an archive missing here is not a cosmetic gap:
	# the control either cannot run at all on a fresh clone, or it certifies
	# whatever stale bytes an earlier bare `zig build` happened to leave. Fail
	# loudly rather than skipping, so the gap cannot go unnoticed again.
	for lib in libsigil.a libsigil_sign.a; do
		[[ -e "result/lib/$lib" ]] \
			|| { echo "FAILED: nix build produced no result/lib/$lib" >&2; exit 1; }
		run install -m644 "result/lib/$lib" "zig-out/lib/$lib"
	done
	# The module probe is a TEST FIXTURE, not a deliverable — hence its own
	# directory. It is the only artifact through which nm can see the
	# importable Zig module, so a missing one is a blind control, not a
	# cosmetic gap. Fail loudly rather than skipping.
	mkdir -p zig-out/test-fixtures
	[[ -e result/test-fixtures/libsigil_module_probe.a ]] \
		|| { echo "FAILED: nix build produced no module probe" >&2; exit 1; }
	run install -m644 result/test-fixtures/libsigil_module_probe.a \
		zig-out/test-fixtures/libsigil_module_probe.a
else
	run zig build "-Doptimize=$optimize" "$@"
fi
