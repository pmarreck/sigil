#!/usr/bin/env bash
# Offline-renewal file vectors (contract section 14.3). Built with jq -cS so
# key order is canonical. Each embedded envelope is the printable-binary
# ENCODING of the exact bytes of an existing vector (Peter 2026-10-01 17:20),
# so the files contain no JSON escapes. Nothing new is signed here.
set -u
D="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"; R="$(cd "$D/../.." && pwd)"
LV="$R/examples/license_vectors"; IV="$R/examples/install_cert_vectors"
MA=$(jq -r .machines.A "$IV/manifest.json")
pb() { printable-binary --no-double-encode-check < "$1" 2>/dev/null; }
LIC=$(pb "$LV/beta_valid.sigil"); CERT=$(pb "$IV/cert_valid.sigil")
jq -cnS --arg lic "$LIC" --arg m "$MA" \
	'{installed_major:"1",installed_minor:"0",license:$lic,machine:$m,operation:"activate",v:"1"}' | tr -d '\n' > "$D/request_activate.json"
jq -cnS --arg cert "$CERT" '{install_cert:$cert,v:"1"}' | tr -d '\n' > "$D/bundle_cert_only.json"
jq -cnS --arg lic "$LIC" --arg cert "$CERT" '{install_cert:$cert,license:$lic,v:"1"}' | tr -d '\n' > "$D/bundle_license_and_cert.json"
# Contract 15.1: the same activation request carrying device hints, each the
# first mecha-validate known answer per kind from examples/hint_vectors.
HV="$R/examples/hint_vectors/manifest.json"
hv() { jq -r --arg k "$1" '[.kats[] | select(.product == "mecha-validate" and .kind == $k)][0].hint' "$HV"; }
jq -cnS --arg lic "$LIC" --arg m "$MA" --arg d "$(hv disk)" --arg a "$(hv mac)" --arg t "$(hv tpm)" \
	'{hints:{disk:$d,mac:$a,tpm:$t},installed_major:"1",installed_minor:"0",license:$lic,machine:$m,operation:"activate",v:"1"}' | tr -d '\n' > "$D/request_activate_hints.json"
echo generated
