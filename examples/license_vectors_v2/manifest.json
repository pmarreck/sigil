      "payload": "v2_valid.payload.json",
      "signed_by_role": "test-beta",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
