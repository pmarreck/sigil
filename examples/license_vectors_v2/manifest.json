          "why": "canonical decimal only"
        }
      ]
    },
    {
      "file": "v2_beta_class.sigil",
      "payload": "v2_beta_class.payload.json",
      "signed_by_role": "test-beta",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 0,
          "expect": "malformed",
