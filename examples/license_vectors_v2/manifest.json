    {
      "file": "../license_vectors/beta_valid.sigil",
      "payload": "../license_vectors/beta_valid.payload.json",
      "signed_by_role": "test-beta",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 99,
          "expect": "authorized",
          "why": "v1 grants are major-only under the v2 entry point"
