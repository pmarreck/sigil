{
  "schema": "mecha-license-vectors/2",
  "contract": "docs/MECHA_LICENSE_CONTRACT_V1.md section 14 (payload v2, version ceiling answered 2026-10-06)",
  "note": "Every eval carries app_minor. Expected decisions are hand-written from the contract. v1 vectors are referenced from ../license_vectors, which stays frozen. mecha_policy ABI 2 decide must reproduce every expect.",
  "trust_roles": {
    "test-beta": {
      "pubkey": "../license_vectors/test_beta.key.pub"
    },
    "test-paid": {
      "pubkey": "../license_vectors/test_paid.key.pub"
    }
  },
  "vectors": [
    {
      "file": "v2_valid.sigil",
      "payload": "v2_valid.payload.json",
      "signed_by_role": "test-paid",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 0,
          "expect": "authorized",
          "why": "ceiling: 1.0 is below 1.3"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 2,
          "expect": "authorized"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 3,
          "expect": "authorized",
          "why": "the licensed minor itself"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 4,
          "expect": "version_ceiling",
          "why": "a later minor needs a refresh"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 2,
          "app_minor": 0,
          "expect": "version_ceiling",
          "why": "a later major needs a purchase"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 0,
          "app_minor": 99,
          "expect": "authorized",
          "why": "an earlier major is below the ceiling whatever its minor"
        },
        {
          "now_utc_date": "2027-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 3,
          "expect": "authorized",
          "why": "expiry day is inclusive"
        },
        {
          "now_utc_date": "2027-10-18",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 3,
          "expect": "expired"
        },
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-rotshield",
          "app_major": 1,
          "app_minor": 3,
          "expect": "wrong_product"
        }
      ]
    },
    {
      "file": "v2_leap.sigil",
      "payload": "v2_leap.payload.json",
      "signed_by_role": "test-paid",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2029-02-28",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 0,
          "expect": "authorized",
          "why": "minted 2028-02-29; +1 year clamps to Feb 28"
        },
        {
          "now_utc_date": "2029-03-01",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 0,
          "expect": "expired"
        },
        {
          "now_utc_date": "2029-02-28",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 1,
          "expect": "version_ceiling"
        }
      ]
    },
    {
      "file": "v2_missing_expiry.sigil",
      "payload": "v2_missing_expiry.payload.json",
      "signed_by_role": "test-paid",
      "sigil_verify": "verified",
      "policy_evals": [
        {
          "now_utc_date": "2026-10-17",
          "product": "mecha-validate",
          "app_major": 1,
          "app_minor": 0,
          "expect": "malformed",
          "why": "expiry is mandatory in v2"
        }
      ]
    },
    {
