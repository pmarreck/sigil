#!/usr/bin/env bash
# Cross-implementation CLI benchmark for PrintableBinary.
#
# The benchmark measures end-to-end encode/decode throughput.  Rust deliberately
# exposes a stdin-only transport CLI, so a tiny per-run adapter feeds it the same
# files as the file-oriented CLIs.  WASM includes wazero startup/runtime cost.

set -euo pipefail

PROJ_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
BENCH_TMPDIR="${TMPDIR:-/tmp}"
BM_DIR="$BENCH_TMPDIR/pb-benchmark-$$"
RESULTS_DIR="$PROJ_ROOT/bm/results"

WARMUP=5
MIN_RUNS=20
SIZES="1K 100K 1M 10M"
QUICK=0
SAVE_TAG=""
LIST_IMPLS=0
REQUESTED_IMPLS=""

declare -a IMPL_NAMES=()
declare -a IMPL_COMMANDS=()
declare -a AVAILABLE_NAMES=()
declare -a UNAVAILABLE_NAMES=()
declare -a UNAVAILABLE_REASONS=()

cleanup() {
	if [[ -d "$BM_DIR" ]]; then
		rm -rf -- "$BM_DIR"
	fi
}
trap cleanup EXIT

usage() {
	cat <<'EOF'
Usage: ./bm/benchmark-zig-opt [options]

Compare the available PrintableBinary CLI implementations with hyperfine.
Rust is adapted from its stdin-only transport CLI; WASM runs through wazero.

Options:
  --quick             Fewer warmup and measurement runs (2 warmups, 5 runs)
  --sizes LIST        Space-separated sizes (default: "1K 100K 1M 10M")
  --impls LIST        Comma- or space-separated implementations to require
                      (c, zig, lua, node, rust, wasm, ape, ffi, pgo)
  --list-impls        Report every implementation and its availability; do not run
  --save TAG          Write hyperfine JSON to bm/results/TAG/
  -h, --help          Show this help

Examples:
  nix develop -c ./bm/benchmark-zig-opt --list-impls
  nix develop -c ./bm/benchmark-zig-opt --quick --sizes "1M"
  nix develop -c ./bm/benchmark-zig-opt --impls rust,wasm,ape --sizes "10M"
EOF
}

while [[ $# -gt 0 ]]; do
	case "$1" in
		--quick)
			QUICK=1
			WARMUP=2
			MIN_RUNS=5
			shift
			;;
		--sizes)
			SIZES="$2"
			shift 2
			;;
		--impls)
			REQUESTED_IMPLS="$2"
			shift 2
			;;
		--list-impls)
			LIST_IMPLS=1
			shift
			;;
		--save)
			SAVE_TAG="$2"
			shift 2
			;;
		-h|--help)
			usage
			exit 0
			;;
		*)
			printf 'Unknown option: %s\n' "$1" >&2
			usage >&2
			exit 1
			;;
	esac
done

is_known_implementation() {
	case "$1" in
		c|zig|lua|node|rust|wasm|ape|ffi|pgo) return 0 ;;
		*) return 1 ;;
	esac
}

wants_implementation() {
	local name="$1"
	local requested
	if [[ -z "$REQUESTED_IMPLS" ]]; then
		return 0
	fi
	local normalized="${REQUESTED_IMPLS//,/ }"
	for requested in $normalized; do
		if [[ "$requested" == "$name" ]]; then
			return 0
		fi
	done
	return 1
}

validate_requested_implementations() {
	local normalized="${REQUESTED_IMPLS//,/ }"
	local requested
	for requested in $normalized; do
		if ! is_known_implementation "$requested"; then
			printf 'Unknown implementation: %s\n' "$requested" >&2
			exit 1
		fi
	done
}

first_executable() {
	local candidate
	for candidate in "$@"; do
		if [[ -x "$candidate" ]]; then
			printf '%s\n' "$candidate"
			return 0
		fi
	done
	return 1
}

record_available() {
	local name="$1"
	local command="$2"
	AVAILABLE_NAMES+=("$name")
	if wants_implementation "$name"; then
		IMPL_NAMES+=("$name")
		IMPL_COMMANDS+=("$command")
	fi
}

record_unavailable() {
	UNAVAILABLE_NAMES+=("$1")
	UNAVAILABLE_REASONS+=("$2")
}

write_rust_adapter() {
	local rust_bin="$1"
	local adapter="$BM_DIR/printable-binary-rust-adapter"
	mkdir -p "$BM_DIR"
	{
		printf '%s\n' '#!/usr/bin/env bash' 'set -u' 'if [[ $# -eq 2 && ( "$1" == "-d" || "$1" == "--decode" ) ]]; then'
		printf '  exec %q -d < "$2"\n' "$rust_bin"
		printf '%s\n' 'fi' 'if [[ $# -eq 1 ]]; then'
		printf '  exec %q < "$1"\n' "$rust_bin"
		printf '%s\n' 'fi' 'printf "Rust benchmark adapter expects [--decode] INPUT_FILE\\n" >&2' 'exit 64'
	} > "$adapter"
	chmod +x "$adapter"
	printf '%s\n' "$adapter"
}

write_wasm_adapter() {
	local wazero_bin="$1"
	local wasm_bin="$2"
	local adapter="$BM_DIR/printable-binary-wasm-adapter"
	mkdir -p "$BM_DIR"
	{
		printf '%s\n' '#!/usr/bin/env bash' 'set -u' 'if [[ $# -eq 2 && ( "$1" == "-d" || "$1" == "--decode" ) ]]; then'
		printf '  exec %q run --env=PRINTABLE_BINARY_MUTE_STATS=true %q -- -d < "$2"\n' "$wazero_bin" "$wasm_bin"
		printf '%s\n' 'fi' 'if [[ $# -eq 1 ]]; then'
		printf '  exec %q run --env=PRINTABLE_BINARY_MUTE_STATS=true %q < "$1"\n' "$wazero_bin" "$wasm_bin"
		printf '%s\n' 'fi' 'printf "WASM benchmark adapter expects [--decode] INPUT_FILE\\n" >&2' 'exit 64'
	} > "$adapter"
	chmod +x "$adapter"
	printf '%s\n' "$adapter"
}

write_ape_adapter() {
	local ape_bin="$1"
	local adapter="$BM_DIR/printable-binary-ape-adapter"
	mkdir -p "$BM_DIR"
	{
		printf '%s\n' '#!/usr/bin/env bash' 'set -u'
		printf 'exec env -i PATH=/usr/bin:/bin:/usr/sbin:/sbin HOME=%q TMPDIR=%q PRINTABLE_BINARY_MUTE_STATS=1 %q "$@"\n' \
			"${HOME:-/tmp}" "$BENCH_TMPDIR" "$ape_bin"
	} > "$adapter"
	chmod +x "$adapter"
	printf '%s\n' "$adapter"
}

discover_implementations() {
	local binary
	local wazero_bin

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-c" "$PROJ_ROOT/result/bin/printable-binary-c"); then
		record_available c "$binary"
	else
		record_unavailable c 'build with ./build native'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary" "$PROJ_ROOT/zig-out/bin/printable-binary" "$PROJ_ROOT/result/bin/printable-binary"); then
		record_available zig "$binary"
	else
		record_unavailable zig 'build with ./build zig'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-luajit"); then
		record_available lua "$binary"
	else
		record_unavailable lua 'LuaJIT CLI missing at bin/printable-binary-luajit'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-node.js"); then
		record_available node "$binary"
	else
		record_unavailable node 'Node CLI missing at bin/printable-binary-node.js'
	fi

	if binary=$(first_executable "$PROJ_ROOT/rust/target/release/printable-binary-rs"); then
		record_available rust "$(write_rust_adapter "$binary")"
	else
		record_unavailable rust 'build with cargo build --release --manifest-path rust/Cargo.toml'
	fi

	if [[ -f "$PROJ_ROOT/bin/printable-binary.wasm" ]]; then
		if wazero_bin=$(command -v wazero 2>/dev/null); then
			record_available wasm "$(write_wasm_adapter "$wazero_bin" "$PROJ_ROOT/bin/printable-binary.wasm")"
		else
			record_unavailable wasm 'install wazero, then run via nix develop -c'
		fi
	else
		record_unavailable wasm 'build with ./build wasm'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-ape.com"); then
		record_available ape "$(write_ape_adapter "$binary")"
	else
		record_unavailable ape 'build with ./build ape'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-ffi"); then
		record_available ffi "$binary"
	else
		record_unavailable ffi 'build with make ffi-cli'
	fi

	if binary=$(first_executable "$PROJ_ROOT/bin/printable-binary-ffi-pgo"); then
		record_available pgo "$binary"
	else
		record_unavailable pgo 'build with make pgo-ffi'
	fi
}

print_inventory() {
	local i
	printf 'PrintableBinary benchmark implementation inventory\n'
	for i in "${!AVAILABLE_NAMES[@]}"; do
		printf '  available  %s\n' "${AVAILABLE_NAMES[$i]}"
	done
	for i in "${!UNAVAILABLE_NAMES[@]}"; do
		printf '  unavailable %s — %s\n' "${UNAVAILABLE_NAMES[$i]}" "${UNAVAILABLE_REASONS[$i]}"
	done
}

ensure_requested_implementations_are_available() {
	local requested
	local name
	local found
	local normalized="${REQUESTED_IMPLS//,/ }"
	for requested in $normalized; do
		found=0
		for name in "${AVAILABLE_NAMES[@]}"; do
			if [[ "$requested" == "$name" ]]; then
				found=1
				break
			fi
		done
		if [[ $found -eq 0 ]]; then
			printf 'Requested benchmark implementation is unavailable: %s\n' "$requested" >&2
			exit 1
		fi
	done
}

size_to_bytes() {
	local spec="$1"
	case "$spec" in
		*K) printf '%s\n' "$(( ${spec%K} * 1024 ))" ;;
		*M) printf '%s\n' "$(( ${spec%M} * 1024 * 1024 ))" ;;
		*G) printf '%s\n' "$(( ${spec%G} * 1024 * 1024 * 1024 ))" ;;
		*) printf '%s\n' "$spec" ;;
	esac
}

generate_data() {
	local size_spec
	local bytes
	mkdir -p "$BM_DIR"
	printf 'Generating deterministic benchmark data...\n'
	for size_spec in $SIZES; do
		bytes=$(size_to_bytes "$size_spec")
		"$PROJ_ROOT/utils/prng" --seed 20260717 --bytes "$bytes" > "$BM_DIR/random_${size_spec}.bin"
		dd if=/dev/zero bs="$bytes" count=1 2>/dev/null | tr '\000' 'A' > "$BM_DIR/ascii_${size_spec}.bin"
		printf '  %s: random and ASCII (%s bytes each)\n' "$size_spec" "$bytes"
	done
}

verify_roundtrip() {
	local size_spec
	local test_file
	local index
	local name
	local command
	local encoded_file
	local decoded_file

	for size_spec in $SIZES; do
		test_file="$BM_DIR/random_${size_spec}.bin"
		break
	done

	printf '\nVerifying round trips before timing...\n'
	for index in "${!IMPL_NAMES[@]}"; do
		name="${IMPL_NAMES[$index]}"
		command="${IMPL_COMMANDS[$index]}"
		encoded_file="$BM_DIR/verify_${name}.pbt"
		decoded_file="$BM_DIR/verify_${name}.bin"
		PRINTABLE_BINARY_MUTE_STATS=1 "$command" "$test_file" > "$encoded_file" 2> "$BM_DIR/${name}.encode.stderr"
		PRINTABLE_BINARY_MUTE_STATS=1 "$command" -d "$encoded_file" > "$decoded_file" 2> "$BM_DIR/${name}.decode.stderr"
		if cmp -s "$test_file" "$decoded_file"; then
			printf '  PASS: %s\n' "$name"
		else
			printf '  FAIL: %s round trip mismatch\n' "$name" >&2
			exit 1
		fi
	done
}

quote_command() {
	local part
	for part in "$@"; do
		printf '%q ' "$part"
	done
}

run_benchmarks() {
	local size_spec
	local data_type
	local input_file
	local index
	local name
	local command
	local encoded_file
	local -a hyperfine_encode
	local -a hyperfine_decode

	printf '\nBenchmark configuration\n'
	printf '  warmup runs: %s\n  measured runs: %s\n  sizes: %s\n  implementations: %s\n' \
		"$WARMUP" "$MIN_RUNS" "$SIZES" "${IMPL_NAMES[*]}"
	printf '  scope: end-to-end CLI; Rust uses stdin adapter; WASM includes wazero\n\n'

	for size_spec in $SIZES; do
		for data_type in random ascii; do
			input_file="$BM_DIR/${data_type}_${size_spec}.bin"
			for index in "${!IMPL_NAMES[@]}"; do
				name="${IMPL_NAMES[$index]}"
				command="${IMPL_COMMANDS[$index]}"
				encoded_file="$BM_DIR/encoded_${name}_${data_type}_${size_spec}.pbt"
				PRINTABLE_BINARY_MUTE_STATS=1 "$command" "$input_file" > "$encoded_file" 2> "$BM_DIR/${name}.prepare.stderr"
			done

			printf '=== Encode: %s %s ===\n' "$data_type" "$size_spec"
			hyperfine_encode=(hyperfine --warmup "$WARMUP" --min-runs "$MIN_RUNS" --shell=none)
			for index in "${!IMPL_NAMES[@]}"; do
				name="${IMPL_NAMES[$index]}"
				command="${IMPL_COMMANDS[$index]}"
				hyperfine_encode+=(-n "${name}-encode-${data_type}-${size_spec}" "$(quote_command "$command" "$input_file")")
			done
			if [[ -n "$SAVE_TAG" ]]; then
				mkdir -p "$RESULTS_DIR/$SAVE_TAG"
				hyperfine_encode+=(--export-json "$RESULTS_DIR/$SAVE_TAG/encode_${data_type}_${size_spec}.json")
			fi
			PRINTABLE_BINARY_MUTE_STATS=1 "${hyperfine_encode[@]}"

			printf '\n=== Decode: %s %s ===\n' "$data_type" "$size_spec"
			hyperfine_decode=(hyperfine --warmup "$WARMUP" --min-runs "$MIN_RUNS" --shell=none)
			for index in "${!IMPL_NAMES[@]}"; do
				name="${IMPL_NAMES[$index]}"
				command="${IMPL_COMMANDS[$index]}"
				encoded_file="$BM_DIR/encoded_${name}_${data_type}_${size_spec}.pbt"
				hyperfine_decode+=(-n "${name}-decode-${data_type}-${size_spec}" "$(quote_command "$command" -d "$encoded_file")")
			done
			if [[ -n "$SAVE_TAG" ]]; then
				hyperfine_decode+=(--export-json "$RESULTS_DIR/$SAVE_TAG/decode_${data_type}_${size_spec}.json")
			fi
			PRINTABLE_BINARY_MUTE_STATS=1 "${hyperfine_decode[@]}"
			printf '\n'
		done
	done
}

validate_requested_implementations
discover_implementations
print_inventory

if [[ $LIST_IMPLS -eq 1 ]]; then
	exit 0
fi

if ! command -v hyperfine >/dev/null 2>&1; then
	printf 'hyperfine is required; run through nix develop -c or install it.\n' >&2
	exit 1
fi
if [[ ! -x "$PROJ_ROOT/utils/prng" ]]; then
	printf 'Missing deterministic input generator: %s/utils/prng\n' "$PROJ_ROOT" >&2
	exit 1
fi

ensure_requested_implementations_are_available
if [[ ${#IMPL_NAMES[@]} -eq 0 ]]; then
	printf 'No benchmark implementations are available. Build one first.\n' >&2
	exit 1
fi

generate_data
verify_roundtrip
run_benchmarks
printf 'Benchmark complete.\n'
