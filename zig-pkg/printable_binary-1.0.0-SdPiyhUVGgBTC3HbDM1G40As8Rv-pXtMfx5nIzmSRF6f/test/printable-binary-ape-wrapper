#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

APE_BIN="${APE_BIN:-$REPO_ROOT/bin/printable-binary-ape.com}"
if [[ ! -x "$APE_BIN" ]]; then
  echo "Error: APE binary not found or not executable: $APE_BIN" >&2
  exit 1
fi

# Cosmopolitan APE uses a host-side loader on some platforms. Running inside a
# Nix devshell can leak SDK/include flags into that loader compilation and
# break execution. Run with a minimal environment + system PATH.
ENV_ARGS=(
  -i
  "PATH=/usr/bin:/bin:/usr/sbin:/sbin"
  "HOME=${HOME:-/tmp}"
  "TMPDIR=${TMPDIR:-/tmp}"
)

for var in DEBUG PRINTABLE_BINARY_MAP PRINTABLE_BINARY_MUTE_STATS LANG LC_ALL; do
  if [[ -n "${!var:-}" ]]; then
    ENV_ARGS+=("$var=${!var}")
  fi
done

exec env "${ENV_ARGS[@]}" "$APE_BIN" "$@"

