#!/usr/bin/env bash
# Container (.pbf.json) CLI round-trip + self-verify test, parameterized by
# IMPLEMENTATION_TO_TEST so every printable-binary executable is exercised the
# same way as it gains `-C`/`--container` support. (issue #1)
#
# MFIC: inverse-pair oracle (decode(encode(file)) == file, byte-identical) plus a
# non-vacuous self-verify (a corrupted container MUST be rejected with nonzero exit).
set -u
IMPL="${IMPLEMENTATION_TO_TEST:-./bin/printable-binary-node.js}"
TMP="$(mktemp -d)"
trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0
ok()  { echo "  ✓ $1"; pass=$((pass+1)); }
bad() { echo "  ✗ $1"; fail=$((fail+1)); }

echo "=== container CLI test: $IMPL ==="

# 1. a file with known, binary-ish bytes
printf 'Hello\x00\x01\xff binary\n{not json}\n' > "$TMP/orig.bin"

# 2. encode -> container
if "$IMPL" -C "$TMP/orig.bin" > "$TMP/orig.pbf.json" 2>"$TMP/enc.err"; then ok "encode -C exits 0"; else bad "encode -C exits 0"; echo "    $(cat "$TMP/enc.err")"; fi

# 3. container shape
grep -q '"format"' "$TMP/orig.pbf.json" 2>/dev/null && grep -q 'printable-binary-file' "$TMP/orig.pbf.json" && ok "container has format=printable-binary-file" || bad "container has format=printable-binary-file"
grep -q '"filename"' "$TMP/orig.pbf.json" 2>/dev/null && grep -q 'orig.bin' "$TMP/orig.pbf.json" && ok "container carries filename" || bad "container carries filename"
grep -q '"crc32"' "$TMP/orig.pbf.json" 2>/dev/null && ok "container carries crc32" || bad "container carries crc32"

# 4. decode -> original bytes
if "$IMPL" -d -C "$TMP/orig.pbf.json" > "$TMP/restored.bin" 2>"$TMP/dec.err"; then ok "decode -d -C exits 0"; else bad "decode -d -C exits 0"; echo "    $(cat "$TMP/dec.err")"; fi
if cmp -s "$TMP/orig.bin" "$TMP/restored.bin"; then ok "round-trip bytes identical"; else bad "round-trip bytes identical"; fi

# 5. self-verify is non-vacuous: corrupt the data string -> decode MUST fail
sed 's/\("data": *"\)/\1ZZZ/' "$TMP/orig.pbf.json" > "$TMP/corrupt.pbf.json"
if "$IMPL" -d -C "$TMP/corrupt.pbf.json" > /dev/null 2>&1; then bad "corrupt container rejected (nonzero exit)"; else ok "corrupt container rejected (nonzero exit)"; fi

# 6. transport resistance: inject a raw newline + spaces INTO the data value (as an
# email wrap/reflow would). The glyph payload is whitespace-agnostic, so decode must
# still recover the original bytes (canonicalize + lenient JSON parse).
awk '{ sub(/"data": "/, "&\n   ") } 1' "$TMP/orig.pbf.json" > "$TMP/wrapped.pbf.json"
if "$IMPL" -d -C "$TMP/wrapped.pbf.json" > "$TMP/restored2.bin" 2>/dev/null && cmp -s "$TMP/orig.bin" "$TMP/restored2.bin"; then ok "transport-mangled container still decodes (whitespace-resistant)"; else bad "transport-mangled container still decodes (whitespace-resistant)"; fi

# --- --spaces in container mode (legible ASCII: literal spaces in the JSON value) ---
# NO schema flag: the crc32_encoded oracle disambiguates spaces-as-data vs transport
# noise. Input has real spaces between passthrough letters; --spaces keeps them literal.
printf 'a b c\n' > "$TMP/sp.bin"

# 7. encode -C --spaces: exit 0 and literal spaces present in the JSON data value
if "$IMPL" -C --spaces "$TMP/sp.bin" > "$TMP/sp.pbf.json" 2>"$TMP/sp.enc.err"; then ok "encode -C --spaces exits 0"; else bad "encode -C --spaces exits 0"; echo "    $(cat "$TMP/sp.enc.err")"; fi
grep -q 'a b c' "$TMP/sp.pbf.json" 2>/dev/null && ok "spaces container has literal spaces in data" || bad "spaces container has literal spaces in data"

# 8. round-trip a spaces container back to identical bytes
if "$IMPL" -d -C "$TMP/sp.pbf.json" > "$TMP/sp.restored" 2>"$TMP/sp.dec.err"; then ok "decode -d -C (spaces) exits 0"; else bad "decode -d -C (spaces) exits 0"; echo "    $(cat "$TMP/sp.dec.err")"; fi
cmp -s "$TMP/sp.bin" "$TMP/sp.restored" && ok "spaces container round-trip identical" || bad "spaces container round-trip identical"

# 9. default (no --spaces) is UNCHANGED: spaces glyph-encoded (no literal "a b c")
"$IMPL" -C "$TMP/sp.bin" > "$TMP/nosp.pbf.json" 2>/dev/null
grep -q 'a b c' "$TMP/nosp.pbf.json" 2>/dev/null && bad "default container encodes spaces as glyph (no literal spaces)" || ok "default container encodes spaces as glyph (no literal spaces)"

# 10. transport resistance in spaces mode: inject a raw NEWLINE only (not spaces, which
# are now data). canonical strips \n, keeps data spaces -> still round-trips, silently.
awk '{ sub(/"data": "/, "&\n") } 1' "$TMP/sp.pbf.json" > "$TMP/sp.wrapped.json"
if "$IMPL" -d -C "$TMP/sp.wrapped.json" > "$TMP/sp.restored2" 2>/dev/null && cmp -s "$TMP/sp.bin" "$TMP/sp.restored2"; then ok "spaces container resists newline injection"; else bad "spaces container resists newline injection"; fi

# 11. ambiguity recovery: a NON-spaces container (space-glyphs) with a transport-injected
# literal space -> both the space-glyph and ' ' present. Decode must (a) recover the original
# bytes by stripping the formatting space (crc-probe pass 2), and (b) WARN that it assumed the
# literal spaces were ignorable formatting BECAUSE the space-glyph was also present. The glyph
# is derived from the impl under test (default-encode one space byte), never hardcoded.
space_glyph="$(printf ' ' | "$IMPL" 2>/dev/null)"
awk '{ sub(/"data": "/, "& ") } 1' "$TMP/nosp.pbf.json" > "$TMP/amb.pbf.json"
"$IMPL" -d -C "$TMP/amb.pbf.json" > "$TMP/amb.restored" 2>"$TMP/amb.err"; rc=$?
{ [ "$rc" -eq 0 ] && cmp -s "$TMP/sp.bin" "$TMP/amb.restored"; } && ok "ambiguous (space+glyph) container recovers original bytes" || bad "ambiguous (space+glyph) container recovers original bytes"
{ grep -qi 'formatting' "$TMP/amb.err" && grep -qF "$space_glyph" "$TMP/amb.err"; } && ok "ambiguity warning names the space glyph and formatting" || bad "ambiguity warning names the space glyph and formatting"

# 12-15. unhonored preserve flags + --container = HARD ERROR (nonzero AND names 'container')
"$IMPL" -C --tabs "$TMP/sp.bin" >/dev/null 2>"$TMP/e.tabs"; rc=$?
{ [ "$rc" -ne 0 ] && grep -qi 'container' "$TMP/e.tabs"; } && ok "container + --tabs hard-errors" || bad "container + --tabs hard-errors"
"$IMPL" -C --crlf "$TMP/sp.bin" >/dev/null 2>"$TMP/e.crlf"; rc=$?
{ [ "$rc" -ne 0 ] && grep -qi 'container' "$TMP/e.crlf"; } && ok "container + --crlf hard-errors" || bad "container + --crlf hard-errors"
"$IMPL" -C -w "$TMP/sp.bin" >/dev/null 2>"$TMP/e.w"; rc=$?
{ [ "$rc" -ne 0 ] && grep -qi 'container' "$TMP/e.w"; } && ok "container + -w hard-errors" || bad "container + -w hard-errors"
"$IMPL" -C -P '#' "$TMP/sp.bin" >/dev/null 2>"$TMP/e.P"; rc=$?
{ [ "$rc" -ne 0 ] && grep -qi 'container' "$TMP/e.P"; } && ok "container + -P hard-errors" || bad "container + -P hard-errors"
echo "container CLI test [$IMPL]: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
