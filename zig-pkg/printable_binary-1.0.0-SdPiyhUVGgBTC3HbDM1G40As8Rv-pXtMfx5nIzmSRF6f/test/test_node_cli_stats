#!/usr/bin/env bash
# Verifies that the Node CLI emits the common processed-input throughput line
# by default and remains silent when PRINTABLE_BINARY_MUTE_STATS is enabled.

# Keep expected command failures observable to the assertions below; this is a
# test harness, so fail explicitly rather than letting errexit hide context.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
NODE_CLI="$SCRIPT_DIR/../bin/printable-binary-node.js"

if [[ ! -x "$NODE_CLI" ]]; then
  echo "SKIP: Node CLI not found at $NODE_CLI"
  exit 0
fi

if ! command -v node >/dev/null 2>&1; then
  echo "SKIP: node is not available in PATH"
  exit 0
fi

TMP_DIR="$(mktemp -d)"
cleanup() { rm -rf "$TMP_DIR"; }
trap cleanup EXIT

input="$TMP_DIR/input.bin"
encoded="$TMP_DIR/encoded.txt"
decoded="$TMP_DIR/decoded.bin"
stderr1="$TMP_DIR/stderr1.log"
stderr2="$TMP_DIR/stderr2.log"
stderr3="$TMP_DIR/stderr3.log"

printf 'stats-check' > "$input"

# Default (no env var): must report a finite throughput line on stderr.
cat "$input" | "$NODE_CLI" > "$encoded" 2> "$stderr1"
if grep -Eq 'Input throughput: [0-9]+[.][0-9]{2} MB read in [0-9]+[.][0-9]{3} s \([0-9]+[.][0-9]{2} MB/s\)' "$stderr1"; then
  :
else
  echo "FAIL: Node CLI did not emit the common processed-input throughput line"
  cat "$stderr1" >&2
  exit 1
fi

# With env var: also silent
cat "$input" | PRINTABLE_BINARY_MUTE_STATS=1 "$NODE_CLI" > /dev/null 2> "$stderr2"
if [[ -s "$stderr2" ]]; then
  echo "FAIL: Node CLI emitted stderr with PRINTABLE_BINARY_MUTE_STATS=1"
  cat "$stderr2"
  exit 1
fi

# Decode must report the same unit while restoring the original bytes.
cat "$encoded" | "$NODE_CLI" -d > "$decoded" 2> "$stderr3"
if ! cmp -s "$input" "$decoded"; then
  echo "FAIL: Node CLI encode/decode mismatch" >&2
  exit 1
fi
if ! grep -Eq 'Input throughput: [0-9]+[.][0-9]{2} MB read in [0-9]+[.][0-9]{3} s \([0-9]+[.][0-9]{2} MB/s\)' "$stderr3"; then
  echo "FAIL: Node CLI decode did not emit the common processed-input throughput line" >&2
  cat "$stderr3" >&2
  exit 1
fi

echo "Node CLI stats test: PASS"
