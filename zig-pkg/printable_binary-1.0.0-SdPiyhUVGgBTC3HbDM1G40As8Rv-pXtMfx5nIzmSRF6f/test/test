#!/usr/bin/env bash
# Master test script for printable_binary
# Runs all test suites

set -e

# Colors for output
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
YELLOW='\033[0;33m'
NC='\033[0m' # No Color

# Path to the printable_binary script (can be overridden with IMPLEMENTATION_TO_TEST)
# Auto-detect the correct path based on script location
SCRIPT_DIR="$(dirname "$0")"
DEFAULT_IMPLEMENTATION="$SCRIPT_DIR/../bin/printable-binary-luajit"
SCRIPT="${IMPLEMENTATION_TO_TEST:-$DEFAULT_IMPLEMENTATION}"

# Fail early if the implementation doesn't exist
if [ ! -x "$SCRIPT" ]; then
    echo -e "${RED}Error: Implementation not found or not executable: $SCRIPT${NC}"
    exit 1
fi

# Detect interpreter requirements only when testing the Lua/Node scripts
SHEBANG=$(head -n 1 "$SCRIPT" 2>/dev/null || echo "")
if echo "$SHEBANG" | grep -qi "luajit"; then
    if ! command -v luajit >/dev/null 2>&1; then
        echo -e "${RED}Error: luajit is required to run $SCRIPT but was not found in PATH.${NC}"
        exit 1
    fi
elif echo "$SHEBANG" | grep -qi "node"; then
    if ! command -v node >/dev/null 2>&1; then
        echo -e "${RED}Error: node is required to run $SCRIPT but was not found in PATH.${NC}"
        exit 1
    fi
fi

# Create temp files for testing
TMP_BINARY=$(mktemp)
TMP_ENCODED=$(mktemp)
TMP_DECODED=$(mktemp)
TMP_MAPPINGS=$(mktemp)
TMP_MAPPINGS_JSON=$(mktemp)
TMP_MAPPINGS_CSV=$(mktemp)
TMP_STATS_STDERR=$(mktemp)
TMP_ENCODED_WITH_WHITESPACE=$(mktemp)

# Cleanup function
cleanup() {
    rm -f "$TMP_BINARY" "$TMP_ENCODED" "$TMP_DECODED" \
          "$TMP_MAPPINGS" "$TMP_MAPPINGS_JSON" "$TMP_MAPPINGS_CSV" \
          "$TMP_STATS_STDERR" "$TMP_ENCODED_WITH_WHITESPACE"
}
trap cleanup EXIT

echo -e "${BLUE}=== PrintableBinary Test Suite ===${NC}"
echo -e "${YELLOW}Testing implementation: $SCRIPT${NC}"

###############################################################################
# BASIC FUNCTIONALITY TESTS
###############################################################################

echo -e "\n${YELLOW}Running basic functionality tests...${NC}"

# Test 1: Simple ASCII roundtrip
echo -e "${BLUE}Test #1: Simple ASCII roundtrip${NC}"
TEST_STRING="Hello, World!"
echo -n "$TEST_STRING" > "$TMP_BINARY"
$SCRIPT "$TMP_BINARY" > "$TMP_ENCODED"
$SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED"
if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Original: $(xxd -p "$TMP_BINARY")"
    echo "Decoded: $(xxd -p "$TMP_DECODED")"
    exit 1
fi

# Test 2: Space character encoding
echo -e "${BLUE}Test #2: Space encoding${NC}"
printf ' ' > "$TMP_BINARY"
ENCODED=$($SCRIPT "$TMP_BINARY")
if [[ "$ENCODED" == "␣" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected: ␣"
    echo "Got: $ENCODED"
    exit 1
fi

# Test 2b: Angle brackets use lookalike glyphs
echo -e "${BLUE}Test #2b: Angle bracket lookalikes${NC}"
printf '<>' > "$TMP_BINARY"
ENCODED=$($SCRIPT "$TMP_BINARY")
if [[ "$ENCODED" == "˂˃" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected: ˂˃"
    echo "Got: $ENCODED"
    exit 1
fi

# Capture help output (used by Tests 7, 7b, 7c)
HELP_OUTPUT=$($SCRIPT --help 2>&1)

# Test 2c: Spaces passthrough option
echo -e "${BLUE}Test #2c: Spaces passthrough option${NC}"
printf 'A B  C' > "$TMP_BINARY"
ENCODED=$($SCRIPT --spaces "$TMP_BINARY")
if [[ "$ENCODED" == "A B  C" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected: A B  C"
    echo "Got: $ENCODED"
    exit 1
fi
DECODED=$($SCRIPT --spaces -d <<<"A B  C")
if [[ "$DECODED" == "A B  C" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected decoded: A B  C"
    echo "Got: $DECODED"
    exit 1
fi

# Test 2d: Spaces option still decodes ␣ as space
echo -e "${BLUE}Test #2d: Spaces decode ␣ + literal spaces${NC}"
DECODED=$($SCRIPT --spaces -d <<<"A␣B C")
if [[ "$DECODED" == "A B C" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected decoded: A B C"
    echo "Got: $DECODED"
    exit 1
fi

# Test 2e: --spaces with --strip-whitespace strips newlines/tabs but keeps spaces
echo -e "${BLUE}Test #2e: Spaces + strip-whitespace strips newlines/tabs${NC}"
DECODED=$($SCRIPT --spaces --strip-whitespace -d <<< $'A B\nC\tD\rE')
if [[ "$DECODED" == "A BCDE" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected decoded: A BCDE"
    echo "Got: $DECODED"
    exit 1
fi

# Test 2f: Spaces option warns about indentation (only relevant with strip-whitespace)
echo -e "${BLUE}Test #2f: Spaces warns about indentation${NC}"
$SCRIPT --spaces --strip-whitespace -d <<< $'A\n  B' >/dev/null 2>"$TMP_STATS_STDERR"
if grep -q "Warning: spaces after newline" "$TMP_STATS_STDERR"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected warning about spaces after newline"
    echo "Got: $(cat "$TMP_STATS_STDERR")"
    exit 1
fi

# Test 3: Quotes and backslashes
echo -e "${BLUE}Test #3: Quotes and backslashes roundtrip${NC}"
printf '\"\\\n' > "$TMP_BINARY"
$SCRIPT "$TMP_BINARY" > "$TMP_ENCODED"
$SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED"
if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Original: $(xxd -p "$TMP_BINARY")"
    echo "Decoded: $(xxd -p "$TMP_DECODED")"
    exit 1
fi

# Test 4: Control characters
echo -e "${BLUE}Test #4: Control characters roundtrip${NC}"
# Create a file with control characters
printf '\000\001\002\003\004' > "$TMP_BINARY"
$SCRIPT "$TMP_BINARY" > "$TMP_ENCODED"
$SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED"
if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Original: $(xxd -p "$TMP_BINARY")"
    echo "Encoded: $(xxd -p "$TMP_ENCODED")"
    echo "Decoded: $(xxd -p "$TMP_DECODED")"
    exit 1
fi

# Test 5: Full binary roundtrip (all 256 bytes)
echo -e "${BLUE}Test #5: Full binary roundtrip (all 256 bytes)${NC}"
# Create a file with all 256 possible byte values
> "$TMP_BINARY"
for i in {0..255}; do
    printf "\\$(printf '%03o' $i)" >> "$TMP_BINARY"
done
$SCRIPT "$TMP_BINARY" > "$TMP_ENCODED"
$SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED"
if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Binary file roundtrip failed."
    # Find first mismatch
    xxd "$TMP_BINARY" > "${TMP_BINARY}.hex"
    xxd "$TMP_DECODED" > "${TMP_DECODED}.hex"
    diff -u "${TMP_BINARY}.hex" "${TMP_DECODED}.hex" | head -n 20
    exit 1
fi

# Test 5b: Buffer stack/heap boundary roundtrip
# Regression: C buffer_init uses a 4096-byte stack buffer; read_file must not
# realloc() that stack pointer. Exactly 4096 bytes is the crash boundary.
echo -e "${BLUE}Test #5b: Buffer boundary roundtrip (4095/4096/4097/8192 bytes)${NC}"
BOUNDARY_OK=1
for sz in 4095 4096 4097 8192; do
    head -c "$sz" /dev/zero | tr '\0' 'Z' > "$TMP_BINARY"
    if ! $SCRIPT "$TMP_BINARY" > "$TMP_ENCODED" 2>/dev/null; then BOUNDARY_OK=0; echo "encode crashed at size $sz"; break; fi
    if ! $SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED" 2>/dev/null; then BOUNDARY_OK=0; echo "decode crashed at size $sz"; break; fi
    if ! cmp -s "$TMP_BINARY" "$TMP_DECODED"; then BOUNDARY_OK=0; echo "roundtrip mismatch at size $sz"; break; fi
done
if [[ "$BOUNDARY_OK" == "1" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    exit 1
fi

# Test 5c: Malformed runtime map (>4-byte glyph token) must be rejected, not crash
# Regression: C make_utf8 memcpy'd strlen(token) into a 4-byte array (stack smash).
echo -e "${BLUE}Test #5c: Malformed runtime map rejected gracefully${NC}"
if [[ -f character_map.txt ]]; then
    BADMAP=$(mktemp)
    awk 'BEGIN{done=0} /^##/{print;next} (done==0){print "TOOLONG8"; done=1; next} {print}' character_map.txt > "$BADMAP"
    rc=0
    PRINTABLE_BINARY_MAP="$BADMAP" $SCRIPT <<< "x" >/dev/null 2>&1 || rc=$?
    rm -f "$BADMAP"
    if [[ $rc -ge 128 ]]; then
        echo -e "${RED}FAIL${NC} (crashed with signal, exit $rc)"
        exit 1
    fi
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${YELLOW}SKIP (no character_map.txt in cwd)${NC}"
fi

# Test 5d: -p (passthrough) / -P (preserve) short-flag consistency across all impls
echo -e "${BLUE}Test #5d: -p passthrough / -P preserve consistency${NC}"
PT=$(printf 'hi' | $SCRIPT -p 2>/dev/null)
PR=$(printf '!' | $SCRIPT -P '!' 2>/dev/null)
if [[ "$PT" == "hi" && "$PR" == "!" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC} (-p passthrough='$PT' want 'hi'; -P preserve='$PR' want '!')"
    exit 1
fi

# Test 5e: -f (bare, default grouping) and -f=NxM (attached spec) consistency
echo -e "${BLUE}Test #5e: -f / -f=NxM format-flag consistency${NC}"
rc1=0; printf 'AAAABBBB' | $SCRIPT -f >/dev/null 2>&1 || rc1=$?
rc2=0; printf 'AAAABBBB' | $SCRIPT -f=2x2 >/dev/null 2>&1 || rc2=$?
if [[ $rc1 -eq 0 && $rc2 -eq 0 ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC} (bare -f exit=$rc1, -f=2x2 exit=$rc2)"
    exit 1
fi

# Test 6: Piped input
echo -e "${BLUE}Test #6: Piped input${NC}"
RESULT=$(echo -n "Test" | $SCRIPT | $SCRIPT -d)
if [[ "$RESULT" == "Test" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected: Test"
    echo "Got: $RESULT"
    exit 1
fi

# Test 7: Help text
echo -e "${BLUE}Test #7: Basic help text${NC}"
if [[ "$HELP_OUTPUT" == *"Usage:"* && "$HELP_OUTPUT" == *"Options:"* ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Help output doesn't contain expected content"
    echo "Got: $HELP_OUTPUT"
    exit 1
fi

# Test 7b: Disassembly options removed
echo -e "${BLUE}Test #7b: Disassembly options are not exposed${NC}"
if [[ "$HELP_OUTPUT" == *"--smart-asm"* || "$HELP_OUTPUT" == *"--arch"* || "$HELP_OUTPUT" == *"--asm"* || "$HELP_OUTPUT" == *" -a,"* ]]; then
    echo -e "${RED}FAIL${NC}"
    echo "Help output still mentions disassembly options, but they should be removed."
    exit 1
else
    echo -e "${GREEN}PASS${NC}"
fi

# Test 7c: Disassembly options are rejected
echo -e "${BLUE}Test #7c: Disassembly options are rejected${NC}"
if $SCRIPT -a "$TMP_BINARY" >/dev/null 2>&1; then
    echo -e "${RED}FAIL${NC}"
    echo "Expected -a/--asm to be rejected, but it succeeded."
    exit 1
fi
if $SCRIPT --smart-asm "$TMP_BINARY" >/dev/null 2>&1; then
    echo -e "${RED}FAIL${NC}"
    echo "Expected --smart-asm to be rejected, but it succeeded."
    exit 1
fi
if $SCRIPT --arch=x64 "$TMP_BINARY" >/dev/null 2>&1; then
    echo -e "${RED}FAIL${NC}"
    echo "Expected --arch to be rejected, but it succeeded."
    exit 1
fi
echo -e "${GREEN}PASS${NC}"

# Test 8: Mappings table output
echo -e "${BLUE}Test #8: Mappings table output${NC}"
$SCRIPT --mappings > "$TMP_MAPPINGS"
if grep -q "Byte" "$TMP_MAPPINGS" && grep -q "0x00" "$TMP_MAPPINGS"; then
if grep -q "NUL" "$TMP_MAPPINGS" && grep -q "·" "$TMP_MAPPINGS"; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "Mappings table missing expected entries"
        exit 1
    fi
else
    echo -e "${RED}FAIL${NC}"
    echo "Mappings table missing header or first entry"
    exit 1
fi

# Test 9: Mappings JSON output
echo -e "${BLUE}Test #9: Mappings JSON output${NC}"
if $SCRIPT --mappings-json > "$TMP_MAPPINGS_JSON"; then
    if python3 - "$TMP_MAPPINGS_JSON" <<'PY'
import json, sys
path = sys.argv[1]
with open(path, 'r', encoding='utf-8') as fh:
    data = json.load(fh)
assert isinstance(data, list) and len(data) == 256
assert data[0]["byte"] == 0
assert data[0]["ascii"] == "NUL"
assert data[0]["mapping"] == "\u00B7"
assert data[-1]["byte"] == 255
PY
    then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "Mappings JSON structure invalid"
        exit 1
    fi
else
    echo -e "${RED}FAIL${NC}"
    echo "Failed to generate mappings JSON"
    exit 1
fi

# Test 10: Mappings CSV output
echo -e "${BLUE}Test #10: Mappings CSV output${NC}"
if $SCRIPT --mappings-csv > "$TMP_MAPPINGS_CSV"; then
    HEADER=$(head -n 1 "$TMP_MAPPINGS_CSV")
    FIRST_LINE=$(sed -n '2p' "$TMP_MAPPINGS_CSV")
if [[ "$HEADER" == "byte,hex,dec,ascii,mapping" ]] && [[ "$FIRST_LINE" == "0,0x00,0,\"NUL\",\"·\"" ]]; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "CSV output unexpected:"
        echo "Header: $HEADER"
        echo "First line: $FIRST_LINE"
        exit 1
    fi
else
    echo -e "${RED}FAIL${NC}"
    echo "Failed to generate mappings CSV"
    exit 1
fi

# Test 11: Stats include wall-clock input throughput and can be muted.
echo -e "${BLUE}Test #11: Stats include throughput and honor PRINTABLE_BINARY_MUTE_STATS${NC}"
printf 'Mute stats test' > "$TMP_BINARY"

# Control: stats should normally be present
PRINTABLE_BINARY_MUTE_STATS= $SCRIPT "$TMP_BINARY" > "$TMP_ENCODED" 2> "$TMP_STATS_STDERR"
if [[ -s "$TMP_STATS_STDERR" ]]; then
    if grep -Eq 'Input throughput: [0-9]+[.][0-9]{2} MB read in [0-9]+[.][0-9]{3} s \([0-9]+[.][0-9]{2} MB/s\)' "$TMP_STATS_STDERR"; then
        echo -e "${GREEN}PASS${NC}"
    else
        echo -e "${RED}FAIL${NC}"
        echo "Expected a finite processed-input MB/s line in stderr"
        cat "$TMP_STATS_STDERR"
        exit 1
    fi
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected stats in stderr when encoding without PRINTABLE_BINARY_MUTE_STATS"
    exit 1
fi

PRINTABLE_BINARY_MUTE_STATS= $SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED" 2> "$TMP_STATS_STDERR"
if grep -Eq 'Input throughput: [0-9]+[.][0-9]{2} MB read in [0-9]+[.][0-9]{3} s \([0-9]+[.][0-9]{2} MB/s\)' "$TMP_STATS_STDERR" \
    && cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected a finite decoded-input MB/s line and a correct roundtrip"
    cat "$TMP_STATS_STDERR"
    exit 1
fi

PRINTABLE_BINARY_MUTE_STATS=1 $SCRIPT "$TMP_BINARY" > "$TMP_ENCODED" 2> "$TMP_STATS_STDERR"
if [[ -s "$TMP_STATS_STDERR" ]]; then
    echo -e "${RED}FAIL${NC}"
    echo "Expected no stats in stderr when encoding with PRINTABLE_BINARY_MUTE_STATS=1"
    cat "$TMP_STATS_STDERR"
    exit 1
fi

PRINTABLE_BINARY_MUTE_STATS=1 $SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED" 2> "$TMP_STATS_STDERR"
if [[ -s "$TMP_STATS_STDERR" ]]; then
    echo -e "${RED}FAIL${NC}"
    echo "Expected no stats in stderr when decoding with PRINTABLE_BINARY_MUTE_STATS=1"
    cat "$TMP_STATS_STDERR"
    exit 1
fi

if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Roundtrip data mismatch under muted stats"
    exit 1
fi

# Test 12: ANSI escape sequences decode correctly (regression test)
echo -e "${BLUE}Test #12: ANSI escape decode preserves bytes${NC}"
COLOR_ENCODED=$'⎋⟦38;5;208mhi⎋⟦0;39m¶'
printf "%s" "$COLOR_ENCODED" > "$TMP_ENCODED"
$SCRIPT -d "$TMP_ENCODED" > "$TMP_DECODED"
RESULT_HEX=$(xxd -p "$TMP_DECODED" | tr -d '\n')
EXPECTED_HEX="1b5b33383b353b3230386d68691b5b303b33396d0a"
if [[ "$RESULT_HEX" == "$EXPECTED_HEX" ]]; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Expected hex: $EXPECTED_HEX"
    echo "Got:         $RESULT_HEX"
    exit 1
fi

# Test 13: Decode survives blank lines in encoded text (regression for APE truncation)
# This tests the block-formatted use case where --strip-whitespace is needed
echo -e "${BLUE}Test #13: Decode handles blank lines in encoded text${NC}"
MULTILINE_CONTENT=$'Line one\nLine two\n\nLine four\nLine five\n'
printf "%s" "$MULTILINE_CONTENT" > "$TMP_BINARY"
$SCRIPT "$TMP_BINARY" > "$TMP_ENCODED"

# Inject real newlines (including a double newline) into the encoded stream to simulate copy/paste wrapping
python3 - "$TMP_ENCODED" "$TMP_ENCODED_WITH_WHITESPACE" <<'PY'
import sys, pathlib, math
src, dest = sys.argv[1], sys.argv[2]
text = pathlib.Path(src).read_text()
if not text:
    pathlib.Path(dest).write_text("")
    sys.exit(0)
# Insert single and double newlines at deterministic cut points
first = max(1, len(text)//3)
second = max(first + 1, 2*len(text)//3)
wrapped = text[:first] + "\n" + text[first:second] + "\n\n" + text[second:] + "\n"
pathlib.Path(dest).write_text(wrapped)
PY

# Use --strip-whitespace (-S) to strip the injected formatting whitespace
$SCRIPT -d -S "$TMP_ENCODED_WITH_WHITESPACE" > "$TMP_DECODED"
if cmp -s "$TMP_BINARY" "$TMP_DECODED"; then
    echo -e "${GREEN}PASS${NC}"
else
    echo -e "${RED}FAIL${NC}"
    echo "Multiline decode lost data (possible truncation)."
    echo "Original (hex): $(xxd -p "$TMP_BINARY")"
    echo "Decoded  (hex): $(xxd -p "$TMP_DECODED")"
    exit 1
fi

###############################################################################
# CHARACTER MAPS TESTS
###############################################################################

echo -e "\n${YELLOW}Running character maps tests...${NC}"

# Create a test binary with all 256 possible byte values
TEST_FILE=$(mktemp)
ENCODED_FILE=$(mktemp)
DECODED_FILE=$(mktemp)

# Cleanup for these files
trap 'cleanup; rm -f "$TEST_FILE" "$ENCODED_FILE" "$DECODED_FILE"' EXIT

# Create file with all 256 byte values
for i in {0..255}; do
    printf "\\$(printf '%03o' $i)" >> "$TEST_FILE"
done

# Encode the test file
echo -e "${BLUE}Encoding all 256 byte values...${NC}"
$SCRIPT "$TEST_FILE" > "$ENCODED_FILE"

# Decode back
echo -e "${BLUE}Decoding back to binary...${NC}"
$SCRIPT -d "$ENCODED_FILE" > "$DECODED_FILE"

# Verify entire file roundtrip
if cmp -s "$TEST_FILE" "$DECODED_FILE"; then
    echo -e "${GREEN}PASS: All 256 byte values correctly encoded and decoded${NC}"
else
    echo -e "${RED}FAIL: Roundtrip encoding/decoding failed${NC}"
    # Find first difference
    cmp -l "$TEST_FILE" "$DECODED_FILE" | head
    exit 1
fi

# Function to test specific byte values
function test_byte() {
  local byte_val=$1
  local name=$2
  local expected_char=$3

  # Create single byte file
  printf "\\$(printf '%03o' $byte_val)" > "$TEST_FILE"

  # Encode
  $SCRIPT "$TEST_FILE" 2>/dev/null > "$ENCODED_FILE"

  # If expected character is provided, verify it appears in the encoding
  if [ ! -z "$expected_char" ]; then
    local encoded_result=$(cat "$ENCODED_FILE")
    if [[ "$encoded_result" != "$expected_char" ]]; then
      echo -e "${RED}FAIL${NC}: Byte ${byte_val} (${name}) encoded as '${encoded_result}', expected '${expected_char}'"
      exit 1
    fi
  fi

  # Decode
  $SCRIPT -d "$ENCODED_FILE" 2>/dev/null > "$DECODED_FILE"

  # Get result as hex
  local result=$(hexdump -ve '1/1 "%02x"' "$DECODED_FILE")
  local expected=$(printf '%02x' $byte_val)

  if [[ "$result" == "$expected" ]]; then
    echo -e "${GREEN}PASS${NC}: Byte ${byte_val} (${name}): ${expected} -> encoded -> decoded -> ${result}"
  else
    echo -e "${RED}FAIL${NC}: Byte ${byte_val} (${name}): ${expected} -> encoded -> decoded -> ${result}"
    exit 1
  fi
}

echo -e "\n${BLUE}Testing important character mappings individually:${NC}"
# Test important control characters
test_byte 0 "NUL"
test_byte 9 "TAB"
test_byte 10 "LF"
test_byte 11 "VT" "↧"  # Expect U+21A7 DOWNWARDS ARROW WITH TIP LEFTWARDS
test_byte 13 "CR"
test_byte 21 "CONTROL_21" "µ"  # Expect µ (U+00B5) MICRO SIGN
test_byte 27 "ESC"
test_byte 32 "SPACE"
test_byte 33 "EXCLAMATION" "ǃ"  # Expect U+01C3 LATIN LETTER RETROFLEX CLICK
test_byte 34 "QUOTE"
test_byte 35 "HASH" "♯"  # Expect U+266F MUSIC SHARP SIGN
test_byte 36 "DOLLAR" "Ꞩ"  # Expect U+A7A8 LATIN CAPITAL LETTER S WITH OBLIQUE STROKE
test_byte 37 "PERCENT" "‰"  # Expect U+2030 PER MILLE SIGN
test_byte 38 "AMPERSAND" "⅋"  # Expect U+214B TURNED AMPERSAND
test_byte 39 "SINGLE QUOTE" "ʼ"  # Expect U+02BC MODIFIER LETTER APOSTROPHE
test_byte 40 "LEFT PAREN" "❨"  # Expect U+2768 MEDIUM LEFT PARENTHESIS ORNAMENT
test_byte 41 "RIGHT PAREN" "❩"  # Expect U+2769 MEDIUM RIGHT PARENTHESIS ORNAMENT
test_byte 42 "ASTERISK" "⁎"  # Expect U+204E LOW ASTERISK
