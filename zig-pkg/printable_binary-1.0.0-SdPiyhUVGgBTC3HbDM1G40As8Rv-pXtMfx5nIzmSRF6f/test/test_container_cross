#!/usr/bin/env bash
# Cross-impl container differential (MFIC): a container emitted by impl A must
# decode byte-identically via impl B, and vice versa. External oracle against
# any envelope/crc/encoding drift between implementations. (issue #1)
set -u
A="${IMPL_A:-./bin/printable-binary-node.js}"
B="${IMPL_B:-./result/bin/printable-binary}"
TMP="$(mktemp -d)"; trap 'rm -rf "$TMP"' EXIT
pass=0; fail=0
ok()  { echo "  ✓ $1"; pass=$((pass+1)); }
bad() { echo "  ✗ $1"; fail=$((fail+1)); }
echo "=== cross-impl container differential: A=$A  B=$B ==="
printf 'cross-impl \x00\x01\xff payload\n{"not":"json"}\ttabbed\n' > "$TMP/orig.bin"

"$A" -C "$TMP/orig.bin" > "$TMP/a.pbf.json" 2>/dev/null
"$B" -d -C "$TMP/a.pbf.json" > "$TMP/b_out.bin" 2>/dev/null
cmp -s "$TMP/orig.bin" "$TMP/b_out.bin" && ok "A-encoded container decodes byte-identically via B" || bad "A-encoded container decodes byte-identically via B"

"$B" -C "$TMP/orig.bin" > "$TMP/b.pbf.json" 2>/dev/null
"$A" -d -C "$TMP/b.pbf.json" > "$TMP/a_out.bin" 2>/dev/null
cmp -s "$TMP/orig.bin" "$TMP/a_out.bin" && ok "B-encoded container decodes byte-identically via A" || bad "B-encoded container decodes byte-identically via A"

echo "cross-impl container [$A <-> $B]: $pass passed, $fail failed"
[ "$fail" -eq 0 ]
