#!/usr/bin/env bash
# Proves ./build_all delegates the complete implementation set to ./build all.

set -u

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
test_root="$(mktemp -d)"
trap 'rm -rf "$test_root"' EXIT

cp "$repo_root/build_all" "$test_root/build_all"
cat > "$test_root/build" <<'EOF'
#!/bin/sh
set -u
printf '%s\n' "$@"
EOF
chmod +x "$test_root/build_all" "$test_root/build"

actual="$(bash "$test_root/build_all")"
if [[ "$actual" == "all" ]]; then
	printf 'PASS: build_all delegates to build all, including Linux APE output\n'
	exit 0
fi

printf 'FAIL: build_all invoked build with %q; expected all\n' "$actual" >&2
exit 1
