#!/usr/bin/env bash
# Proves the public executable names select Zig by default while retaining LuaJIT.

set -u

canonical_cli="${1:?Usage: test_cli_layout CANONICAL_ZIG_CLI LUAJIT_CLI}"
luajit_cli="${2:?Usage: test_cli_layout CANONICAL_ZIG_CLI LUAJIT_CLI}"
failures=0

pass() {
	printf 'PASS: %s\n' "$1"
}

fail() {
	printf 'FAIL: %s\n' "$1" >&2
	failures=$((failures + 1))
}

if [[ -x "$canonical_cli" && "$(basename "$canonical_cli")" == "printable-binary" ]]; then
	pass "canonical Zig CLI is installed as printable-binary"
else
	fail "canonical Zig CLI must be an executable named printable-binary"
fi

if [[ -x "$luajit_cli" && "$(basename "$luajit_cli")" == "printable-binary-luajit" ]]; then
	pass "legacy LuaJIT CLI remains available as printable-binary-luajit"
else
	fail "legacy LuaJIT CLI must be an executable named printable-binary-luajit"
fi

if [[ -x "$canonical_cli" ]]; then
	canonical_output="$(printf 'CanonicalZig' | PRINTABLE_BINARY_MUTE_STATS=1 "$canonical_cli" 2>/dev/null)"
	if [[ "$canonical_output" == "CanonicalZig" ]]; then
		pass "canonical Zig CLI encodes literal input"
	else
		fail "canonical Zig CLI did not encode literal input as expected"
	fi
fi

if [[ -x "$luajit_cli" ]]; then
	luajit_output="$(printf 'LegacyLuaJit' | PRINTABLE_BINARY_MUTE_STATS=1 "$luajit_cli" 2>/dev/null)"
	if [[ "$luajit_output" == "LegacyLuaJit" ]]; then
		pass "LuaJIT CLI remains usable under its explicit name"
	else
		fail "LuaJIT CLI did not encode literal input as expected"
	fi
fi

exit "$failures"
