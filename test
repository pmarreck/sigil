#!/usr/bin/env bash
# Master test runner for sigil.
# Runs Zig unit tests + CLI integration tests.
# Exit code = total number of failures across all suites, capped at 255.
#
# Per Mecha conventions: never use `set -euo pipefail` in test scripts.
# `set -e` silently aborts when a command-under-test returns non-zero, which
# masks exactly the intended-failure paths a verifier most needs to prove.
set -u

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOTAL_FAIL=0
TOTAL_PASS=0

# Per-suite timing, so the cost of the run is attributable. Monotonic seconds
# from /proc/uptime (CLOCK_BOOTTIME) where it exists; wall time otherwise, and
# the report says which. The build is timed separately from the suites.
CLOCK=monotonic
[[ -r /proc/uptime ]] || CLOCK=wall
now() {
	local up _
	if [[ "$CLOCK" == monotonic ]]; then
		read -r up _ </proc/uptime
		printf '%s' "$up"
	else
		printf '%s' "$EPOCHREALTIME"
	fi
}
seconds_between() { awk -v a="$1" -v b="$2" 'BEGIN { printf "%.2f", b - a }'; }
TIMINGS=()
BUILD_SECONDS="skipped"
RUN_STARTED=$(now)

# Scratch for suite results, removed on exit. Only this directory.
RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/sigil-test-run-XXXXXX")" || { echo "FATAL: no scratch directory"; exit 1; }
trap 'rm -rf -- "$RUN_DIR"' EXIT

# exec_suite PREFIX CMD: run CMD, saving its output, status and duration
# under PREFIX. Safe to run in the background; it touches no counters.
exec_suite() {
	local prefix="$1" cmd="$2" started ended
	started=$(now)
	eval "$cmd" >"$prefix.out" 2>&1
	echo "$?" >"$prefix.rc"
	ended=$(now)
	seconds_between "$started" "$ended" >"$prefix.time"
}

# report_suite NAME PREFIX: count and print a suite exec_suite finished.
report_suite() {
	local name="$1" prefix="$2" output rc took
	echo ""
	echo "━━━ $name ━━━"
	output=$(<"$prefix.out")
	rc=$(<"$prefix.rc")
	took=$(<"$prefix.time")
	TIMINGS+=("$took	$name")
	local pass fail
	# Recognize multiple summary formats:
	#   - shell-style "N passed" / "N failed"
	#   - Zig --summary all success: "N/N tests passed"
	#   - Zig --summary all failure: "N pass, N fail (M total)"
	# SC2312 is deliberate here and safe: grep exits 1 when a suite simply
	# printed no "N passed" line, which `|| echo 0` handles. Crucially the
	# suite's OWN status is captured as $rc above and re-checked below, so a
	# crashed suite cannot masquerade as "0 failures" — that is the safety net
	# these two lines are allowed to lean on.
	# shellcheck disable=SC2312
	pass=$(echo "$output" | grep -oE '[0-9]+(/[0-9]+)?( tests?)? pass(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	# shellcheck disable=SC2312
	fail=$(echo "$output" | grep -oE '[0-9]+( tests?)? fail(ed)?' | head -1 | grep -oE '^[0-9]+' || echo "0")
	if [[ $rc -ne 0 && "$fail" == "0" ]]; then
		fail=1
	fi
	TOTAL_PASS=$((TOTAL_PASS + pass))
	TOTAL_FAIL=$((TOTAL_FAIL + fail))
	echo "$output" | tail -12
	echo "  (${took}s)"
}

run_suite() {
	exec_suite "$RUN_DIR/current" "$2"
	report_suite "$1" "$RUN_DIR/current"
}

echo "╔══════════════════════════════════════════════════════════════╗"
echo "║   sigil Master Test Suite                                    ║"
echo "╚══════════════════════════════════════════════════════════════╝"

# Build first (ReleaseFast, nix-sandboxed) so the CLI tests exercise a real
# artifact rather than a stale one.

# Sandbox awareness: inside a Nix build (CI runs THIS script as the check
# checks.test-all) the tools are already on PATH and nested `nix develop` /
# `nix build` are impossible. Locally, zig is usually absent from PATH and the
# nix develop wrapper supplies it. One mechanism, no second code path.
if command -v zig >/dev/null 2>&1; then NIXDEV=""; else NIXDEV="nix develop -c"; fi

echo ""
echo "Building (ReleaseFast)..."
# Harness self-check FIRST: it needs no binary, and if the controls below
# cannot fail, every subsequent "pass" in this run is unverified.
if [[ -f "$SCRIPT_DIR/tests/test_harness_guards" ]]; then
	run_suite "Harness Guards" "bash '$SCRIPT_DIR/tests/test_harness_guards'"
fi

# Masked-return-value gate for Bash and C. Zig rejects this class at compile
# time; these two languages make it opt-in, so this is the opt-in.
if [[ -f "$SCRIPT_DIR/tests/test_lint" ]]; then
	run_suite "Lint (masked returns)" "$NIXDEV bash '$SCRIPT_DIR/tests/test_lint'"
fi

# NOT `./build | tail -3 || fatal` — `||` would bind to the pipeline, whose
# status is `tail`'s (always 0), so a failed build would slip through and the
# suite would certify a stale binary. Capture first, then judge.
if [[ "${SIGIL_SKIP_BUILD:-0}" == "1" ]]; then
	# The caller (the CI sandbox) already built and patched zig-out. Trust,
	# but verify the one thing the suites below cannot run without.
	if [[ ! -x "$SCRIPT_DIR/zig-out/bin/sigil" ]]; then
		echo "FATAL: SIGIL_SKIP_BUILD=1 but zig-out/bin/sigil is missing"
		exit 1
	fi
else
	build_started=$(now)
	build_log=$("$SCRIPT_DIR/build" 2>&1)
	build_rc=$?
	build_ended=$(now)
	BUILD_SECONDS="$(seconds_between "$build_started" "$build_ended")s"
	echo "$build_log" | tail -3
	if [[ $build_rc -ne 0 ]]; then
		echo "FATAL: build failed"
		exit 1
	fi
fi

# Every suite from here on is independent: each works in its own scratch
# directory, no suite writes into the repository (license_vectors_v2.sh
# regenerates in scratch), and the binaries are read-only. They are queued in
# a fixed order, run with at most SIGIL_TEST_JOBS at once (default: the core
# count, capped at 16), and reported afterwards in queue order.
QUEUE_NAMES=()
QUEUE_CMDS=()
queue() { QUEUE_NAMES+=("$1"); QUEUE_CMDS+=("$2"); }

# Zig unit tests — `--summary all` makes Zig emit "N/N tests passed"
# which report_suite's grep can pick up.
queue "Zig Unit Tests" "$NIXDEV zig build test --summary all 2>&1"

# Architecture invariant: the shipping verifier contains no signing code.
if [[ -f "$SCRIPT_DIR/tests/test_no_signing_symbols" ]]; then
	queue "Symbol Separation" "$NIXDEV bash '$SCRIPT_DIR/tests/test_no_signing_symbols'"
fi
# The same invariant for the Rust verify library. Required: no skip.
queue "Symbol Separation (Rust)" "$NIXDEV bash '$SCRIPT_DIR/tests/test_no_signing_symbols_rust'"

# The customer's link path: stock cc against libsigil.a, exercising the
# sigil_verify primitive that the C CLI never calls.
if [[ -f "$SCRIPT_DIR/tests/test_c_conformance" ]]; then
	queue "C Conformance (stock cc)" "bash '$SCRIPT_DIR/tests/test_c_conformance'"
fi

# The Rust implementation must answer exactly as the Zig one does. The same
# C driver is linked against each archive and the outputs are compared. These
# suites are required: a missing script fails here rather than skipping.
queue "Differential (Zig vs Rust)" "bash '$SCRIPT_DIR/tests/differential/run'"
queue "Differential mecha_policy (Zig vs Rust)" "bash '$SCRIPT_DIR/tests/differential/policy'"
queue "Differential signing (Zig vs Rust)" "bash '$SCRIPT_DIR/tests/differential/sign'"

# The Rust CLI may reach an implementation only through the C ABI.
queue "Rust CLI boundary" "$NIXDEV bash '$SCRIPT_DIR/tests/test_rust_cli_boundary'"

# CLI surface tests (Bash-driven, against the built binary).
export SIGIL_BIN="${SIGIL_BIN:-$SCRIPT_DIR/zig-out/bin/sigil}"
# The other frontend and library pairs: the C or Rust CLI on the Zig or Rust
# libraries. tests/integration/cross_impl.sh compares all four at once,
# with this one as the reference, so it runs once rather than per pair.
PAIR_LABELS=("C CLI on Rust" "Rust CLI on Zig" "Rust CLI on Rust")
PAIR_BINS=(
	"${SIGIL_C_ON_RUST_OUT:-$SCRIPT_DIR/.nix-out/c-on-rust}/bin/sigil"
	"${SIGIL_RUST_ON_ZIG_OUT:-$SCRIPT_DIR/.nix-out/rust-cli-on-zig}/bin/sigil"
	"${SIGIL_RUST_ON_RUST_OUT:-$SCRIPT_DIR/.nix-out/rust-cli-on-rust}/bin/sigil"
)
SIGIL_PAIR_BINS="$SIGIL_BIN"
for b in "${PAIR_BINS[@]}"; do SIGIL_PAIR_BINS="$SIGIL_PAIR_BINS:$b"; done
export SIGIL_PAIR_BINS
queue "CLI Surface" "$NIXDEV bash '$SCRIPT_DIR/tests/cli/test_cli'"

# Integration tests — add as they're written.
for t in "$SCRIPT_DIR"/tests/integration/*.sh; do
	[[ -f "$t" ]] || continue
	queue "Integration: ${t##*/}" "$NIXDEV bash '$t'"
done

# The same suites again on every other pair. A suite drives the binary when
# it reads SIGIL_BIN; that is discovered here rather than listed, so a new
# suite joins every pair. A missing pair fails, never skips.
PAIR_SUITES=()
for t in "$SCRIPT_DIR/tests/cli/test_cli" "$SCRIPT_DIR"/tests/integration/*.sh; do
	if [[ -f "$t" ]] && grep -q 'SIGIL_BIN' "$t"; then PAIR_SUITES+=("$t"); fi
done
for p in "${!PAIR_BINS[@]}"; do
	queue "${PAIR_LABELS[p]}: the binary was built" "test -x '${PAIR_BINS[p]}' && echo '1 passed'"
	for t in "${PAIR_SUITES[@]}"; do
		queue "${PAIR_LABELS[p]}: ${t##*/}" "SIGIL_BIN='${PAIR_BINS[p]}' $NIXDEV bash '$t'"
	done
done

cores=$(nproc 2>/dev/null || echo 4)
JOBS="${SIGIL_TEST_JOBS:-$(( cores > 16 ? 16 : cores ))}"
running=0
for i in "${!QUEUE_CMDS[@]}"; do
	if (( running >= JOBS )); then
		wait -n
		running=$((running - 1))
	fi
	exec_suite "$RUN_DIR/q-$i" "${QUEUE_CMDS[i]}" &
	running=$((running + 1))
done
wait
for i in "${!QUEUE_NAMES[@]}"; do
	report_suite "${QUEUE_NAMES[i]}" "$RUN_DIR/q-$i"
done

# Timing report. Some suites run concurrently, so the sum of suite times is
# worker time, not waiting time; the wall time of execution (everything but
# the build) is reported on its own.
RUN_ENDED=$(now)
printf '%s\n' "${TIMINGS[@]}" >"$RUN_DIR/timings"
suite_seconds=$(awk -F'\t' '{ t += $1 } END { printf "%.1f", t }' "$RUN_DIR/timings")
run_seconds=$(seconds_between "$RUN_STARTED" "$RUN_ENDED")
execution_seconds=$(awk -v r="$run_seconds" -v b="${BUILD_SECONDS%s}" 'BEGIN { if (b == "skipped") b = 0; printf "%.1f", r - b }')
echo ""
echo "Timing ($CLOCK clock): build $BUILD_SECONDS; execution ${execution_seconds}s wall;"
echo "suite time ${suite_seconds}s summed over ${#TIMINGS[@]} suites, up to $JOBS at once. Costliest:"
sort -t$'\t' -k1,1 -rn "$RUN_DIR/timings" >"$RUN_DIR/timings.sorted"
awk -F'\t' 'NR <= 10 { printf "  %8ss  %s\n", $1, $2 }' "$RUN_DIR/timings.sorted"

echo ""
echo "╔══════════════════════════════════════════════════════════════╗"
echo "║  TOTAL: $TOTAL_PASS passed, $TOTAL_FAIL failed"
echo "╚══════════════════════════════════════════════════════════════╝"

# Capped: an exit status is taken modulo 256, so 256 failures would read as success.
exit $(( TOTAL_FAIL > 255 ? 255 : TOTAL_FAIL ))
